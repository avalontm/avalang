extends layouts.main

properties
    title = "Página no encontrada"
end

view
    column
        fill = "true"
        padding = 20
        gap = 12

        text
            value = "404"
            fontSize = 48
        end

        text
            value = "No encontramos '" + request.path + "'"
            fontSize = 18
        end

        link
            text = "Volver al inicio"
            href = "/"
            class = "text-blue-600 hover:underline"
        end
    end
end
