## Saluda a alguien por su nombre.
## @param name: nombre de la persona a saludar.
## @param greeting: saludo a usar, por defecto "Hola".
func greet(name, greeting="Hola")
    print($"{greeting}, {name}!")
end

greet("Raul")

for name in ["ana", "jose", "raul"] then
	print($"{name}")
end