# Test 1: Ordenamiento Burbuja (Bubble Sort)
arr = [64, 34, 25, 12, 22, 11, 90]
print("Original:", arr)

n = 7
i = 0
while i < n - 1
    j = 0
    while j < n - i - 1
        if arr[j] > arr[j + 1] then
            temp = arr[j]
            arr[j] = arr[j + 1]
            arr[j + 1] = temp
        end
        j = j + 1
    end
    i = i + 1
end

print("Ordenado:", arr)
print("Esperado: [11, 12, 22, 25, 34, 64, 90]")