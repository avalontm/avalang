# Test asignaciones normales
print("=== Asignaciones normales ===")

a = 1
print("a =", a)

x = 42
y = "hello"
z = true
print("x =", x, "y =", y, "z =", z)

# Test con separaciones en misma linea
print("\n=== Con comas en misma linea ===")

a = 10, b = 20
print("a =", a, "b =", b)

x = 1, y = 2, z = 3
print("x =", x, "y =", y, "z =", z)

m = "primero", n = "segundo", o = "tercero"
print("m =", m, "n =", n, "o =", o)

# Mezcla: normales y con comas
print("\n=== Mezcla ===")

p = 100
q = 200, r = 300
print("p =", p, "q =", q, "r =", r)

# Sin espacios
print("\n=== Sin espacios ===")
i=1,j=2,k=3
print("i =", i, "j =", j, "k =", k)

print("\n=== Todos los tests pasaron ===")