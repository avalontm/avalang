# scripts/mysql_debug.ava
# Version con checkpoints para encontrar la linea exacta que tira
# "attempt to call a non-callable value". Corré esto en vez del demo
# completo -- el ultimo "chk N" que se imprima antes del crash te dice
# adonde mirar.

print("chk 1: antes de declarar extern")

extern "libmysql" as MySQL
    func mysql_init(existing)
    func mysql_real_connect(mysql, host, user, passwd, db, port, unix_socket, client_flag)
    func mysql_query(mysql, query)
    func mysql_error(mysql)
    func mysql_store_result(mysql)
    func mysql_num_fields(res)
    func mysql_num_rows(res)
    func mysql_fetch_row(res)
    func mysql_free_result(res)
    func mysql_close(mysql)
end

print("chk 2: extern declarado, type(MySQL) = " + str(type(MySQL)))

print("chk 3: probando mem_is_null suelto (sin extern)")
print(mem_is_null(nil))
print(mem_is_null(0))
print("chk 4: mem_is_null funciona")

print("chk 5: probando mem_peek_string suelto")
print(mem_peek_string(nil))
print("chk 6: mem_peek_string funciona")

print("chk 7: antes de mysql_init")
conn = MySQL.mysql_init(nil)
print("chk 8: mysql_init devolvio, type(conn) = " + str(type(conn)))
print("chk 9: mysql_init es null? " + str(mem_is_null(conn)))

print("chk 10: antes de mysql_real_connect")
conn = MySQL.mysql_real_connect(conn, "127.0.0.1", "root", "tu_password", "tu_basededatos", 3306, nil, 0)
print("chk 11: mysql_real_connect devolvio, es null? " + str(mem_is_null(conn)))

print("chk 12: fin")
