# scripts/visibilidad_modificadores.ava
#
# Prueba de las 4 combinaciones posibles de modificadores de miembro
# (static / private), tal como quedaron definidas en
# DISENO_visibilidad_clases_avalang.md (secciones 3, 9 y 10, Fase F):
#
#   (nada)           -> instancia, público      (comportamiento de siempre)
#   private          -> instancia, NO público
#   static           -> compartido por la clase, público
#   static private    -> compartido por la clase, NO público
#
# Nada de esto cambia el comportamiento de una clase que no usa ninguno
# de los dos modificadores -- ver scripts/dog.ava y scripts/test.ava,
# que siguen intactos.
#
# creado por: AvalonTM

class Animal
    static totalAnimales = 0        # static público: compartido, se ve desde cualquier lado
    private vidaSecreta = 100       # privado: solo Animal lo ve

    energia = 10                    # sin modificador -> público, de instancia (default de siempre)

    func Animal(nombre)
        this.nombre = nombre        # público, de instancia (default)
        Animal.totalAnimales += 1   # un static se toca por nombre de clase, no por "this."
    end

    func comer()
        this.energia += 5
        this.regenerar()            # un método private SÍ se puede llamar desde adentro
    end

    private func regenerar()
        this.vidaSecreta += 1       # privado usando otro privado: sin problema, mismo lado
    end

    static func especie()
        return "animal generico"    # static func: no recibe "this", se llama Animal.especie()
    end
end

class Dog : Animal
    func Dog(nombre)
        base(nombre)                # llama al constructor de Animal
    end

    func saludar()
        print("Guau, soy " + this.nombre)   # "nombre" es público -> Dog lo hereda y lo ve
        # this.vidaSecreta   <- privado de Animal: Dog no debería verlo en el autocompletado
        # this.regenerar()   <- privado de Animal: tampoco debería aparecer sugerido
    end
end

class Contador
    static private func validarLimite(n)
        return n < 1000
    end

    static func crear(n)
        if Contador.validarLimite(n) then      # static private: se puede llamar desde
            return n                            # otro método de la MISMA clase sin problema
        end
        return 0
    end
end

perro = Dog("Firulais")
perro.saludar()                      # esperado: "Guau, soy Firulais"
print(perro.energia)                 # esperado: 15 -> público, se ve sin problema desde afuera
perro.comer()                        # público -> se ve y se puede llamar desde afuera
print(perro.energia)                 # esperado: 20 (15 + 5 de comer())

# perro.vidaSecreta                  <- NO debería sugerirse en el editor: es private
# perro.regenerar()                  <- NO debería sugerirse en el editor: es private

print(Dog.totalAnimales)             # esperado: 1 -> se accede por nombre de clase, compartido con Animal
print(Dog.especie())                 # esperado: "animal generico" -> static heredado, sin instancia

print(Contador.crear(50))            # esperado: 50 -> público, se puede llamar desde afuera
# print(Contador.validarLimite(50))  <- NO debería sugerirse en el editor: es static private
