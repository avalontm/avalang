# scripts/test_coroutine_nested_yield.ava
#
# Regresión para la Fase 1 de AvaLang_Async_Await_Plan.md:
# "corrutina que hace yield dentro de una función auxiliar llamada
# desde el cuerpo del generador (no solo en el nivel superior)".
#
# Antes del fix de propagación de suspensión en OpBaseCall/VM::Call,
# este caso NO fallaba con un error visible -- simplemente perdía la
# suspensión en cuanto el yield cruzaba la llamada a gen_helper(),
# devolviendo valores incorrectos o corrompiendo el stack de frames.
#
# creado por: AvalonTM

func gen_helper()
    yield "desde helper 1"
    yield "desde helper 2"
end

func gen_body()
    gen_helper()          # yield anidado: NO está en el frame 0 de la corrutina
    yield "desde body"
end

co = coroutine(gen_body)

print(resume(co))   # esperado: "desde helper 1"
print(resume(co))   # esperado: "desde helper 2"
print(resume(co))   # esperado: "desde body"
