# ============================================
# TEST: test_if.ava
# Category: 01_control_flow
# Feature: if/elif/else
# ============================================

# --- Test 1: Simple if ---
x = 10
if x > 5 then
    print("1. x is greater than 5")
end

# --- Test 2: if/else ---
y = 3
if y > 10 then
    print("2. y > 10 (never)")
else
    print("2. y <= 10 (correct)")
end

# --- Test 3: if/elif/else chain ---
grade = 85
if grade >= 90 then
    print("3. Grade: A")
elif grade >= 80 then
    print("3. Grade: B")
elif grade >= 70 then
    print("3. Grade: C")
elif grade >= 60 then
    print("3. Grade: D")
else
    print("3. Grade: F")
end

# --- Test 4: Nested if ---
a = 5
b = 10
if a > 0 then
    if b > 0 then
        print("4. Both a and b are positive")
    end
end

# --- Test 5: Complex condition in if ---
num = 7
if num > 0 and num % 2 == 0 then
    print("5. Positive even")
elif num > 0 and num % 2 != 0 then
    print("5. Positive odd")
else
    print("5. Non-positive")
end

# --- Test 6: if without parentheses (requires 'then') ---
z = 15
if z == 15 then
    print("6. z equals 15 (no parens, has 'then')")
end

# --- Test 7: Empty-like else with pass ---
flag = false
if flag == true then
    print("7. flag is true")
else
    # pass
end
print("7. Exited cleanly after empty else")

print("If/elif/else tests completed!")