# scripts/mysql_demo.ava
#
# Demo de `extern` llamando a libmysql.dll (MySQL Connector/C, o el
# libmysql.dll que trae el propio MySQL Server) para conectar y correr
# un SELECT desde AvaLang.
#
# Requisitos para correr esto de verdad:
#   - libmysql.dll debe estar en el PATH o al lado del .exe del
#     interprete de AvaLang (es el mismo nombre logico que va en
#     extern "libmysql" -- ver CandidateFileNames en vm_extern.cpp:
#     en Windows busca "libmysql" tal cual y despues "libmysql.dll").
#   - Ajusta host/user/passwd/db/puerto mas abajo a tu servidor real.
#
# Limitaciones del FFI actual (ver EXTERN_FFI_TODO.md) que este script
# ya tiene en cuenta:
#   - Todo valor de retorno de una funcion extern se interpreta como
#     entero de 64 bits. Para mysql_init/mysql_real_connect/etc, que en
#     C retornan punteros (MYSQL*, MYSQL_RES*), esto en realidad nos
#     sirve tal cual: el puntero llega a AvaLang como un numero opaco
#     ("handle") que despues se puede volver a pasar como argumento a
#     otra llamada extern sin problema.
#   - Pero un puntero no es lo mismo que el string/dato al que apunta.
#     Para leer texto real detras de un char* (mysql_error, columnas de
#     una fila) se usan los builtins nuevos mem_peek_string / mem_peek_ptr
#     / mem_is_null (ver core/src/builtins/builtin_mem.cpp) -- son el
#     complemento que le faltaba al extern para este caso de uso.

extern "libmysql" as MySQL
    func mysql_init(existing)
    func mysql_real_connect(mysql, host, user, passwd, db, port, unix_socket, client_flag)
    func mysql_query(mysql, query)
    func mysql_error(mysql)
    func mysql_store_result(mysql)
    func mysql_num_fields(res)
    func mysql_num_rows(res)
    func mysql_fetch_row(res)
    func mysql_free_result(res)
    func mysql_close(mysql)
end

host = "127.0.0.1"
user = "root"
passwd = "tu_password"
db = "tu_basededatos"
port = 3306

handle = MySQL.mysql_init(nil)
conn = MySQL.mysql_real_connect(handle, host, user, passwd, db, port, nil, 0)

if mem_is_null(conn) then
    print("no se pudo conectar: " + str(mem_peek_string(MySQL.mysql_error(handle))))
else
    print("conectado")

    query = "SELECT id, nombre FROM usuarios LIMIT 10"
    status = MySQL.mysql_query(conn, query)

    if status != 0 then
        print("error en query: " + str(mem_peek_string(MySQL.mysql_error(conn))))
    else
        result = MySQL.mysql_store_result(conn)

        if mem_is_null(result) then
            print("query sin resultado (probablemente no era un SELECT)")
        else
            fields = MySQL.mysql_num_fields(result)
            rows = MySQL.mysql_num_rows(result)
            print("filas: " + str(rows) + ", columnas: " + str(fields))

            row = MySQL.mysql_fetch_row(result)
            while not mem_is_null(row)
                linea = ""
                for i in range(fields) then
                    col = mem_peek_string(mem_peek_ptr(row, i))
                    if mem_is_null(col) then
                        col = "NULL"
                    end
                    linea = linea + str(col) + " | "
                end
                print(linea)
                row = MySQL.mysql_fetch_row(result)
            end

            MySQL.mysql_free_result(result)
        end
    end

    MySQL.mysql_close(conn)
end
