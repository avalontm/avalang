# ============================================
# TEST: test_operators.ava
# Category: 00_basics
# Feature: Operadores aritméticos, comparación, lógicos
# ============================================

# --- Test 1: Arithmetic ---
print("1. Arithmetic:")
print("   10 + 5 = ", 10 + 5)
print("   10 - 3 = ", 10 - 3)
print("   4 * 7  = ", 4 * 7)
print("   20 / 4 = ", 20 / 4)
print("   17 % 5 = ", 17 % 5)
print("   2 ** 3 = ", 2 ** 3)

# --- Test 2: Comparison ---
print("2. Comparison:")
print("   5 == 5   = ", 5 == 5)
print("   5 != 3   = ", 5 != 3)
print("   4 < 7    = ", 4 < 7)
print("   6 > 4    = ", 6 > 4)
print("   3 <= 3   = ", 3 <= 3)
print("   5 >= 5   = ", 5 >= 5)

# --- Test 3: Logical ---
print("3. Logical:")
print("   true and false = ", true and false)
print("   true or false  = ", true or false)
print("   not true       = ", not true)
print("   not false      = ", not false)

# --- Test 4: Compound conditions ---
print("4. Compound:")
x = 10
print("   x > 5 and x < 15 = ", x > 5 and x < 15)
print("   x == 10 or x > 20 = ", x == 10 or x > 20)

# --- Test 5: Increment/Decrement ---
print("5. Inc/Dec:")
counter = 5
print("   counter = ", counter)
counter++
print("   counter++ = ", counter)
counter--
print("   counter-- = ", counter)

# --- Test 6: Augmented assignment ---
print("6. Augmented assign:")
val = 10
val += 5
print("   val += 5  = ", val)
val -= 3
print("   val -= 3  = ", val)
val *= 2
print("   val *= 2  = ", val)
val /= 4
print("   val /= 4  = ", val)

print("Operator tests completed!")