{
  "name": "avalang",
  "displayName": "AvaLang",
  "description": "Syntax highlighting for the AvaLang scripting language (.ava files)",
  "version": "0.3.3",
  "publisher": "avalontm",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "avalang",
    "ava",
    "syntax",
    "highlighting"
  ],
  "icon": "icons/icon.png",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:avalang"
  ],
  "galleryBanner": {
    "color": "#1E1E2E",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/avalontm/avalang"
  },
  "contributes": {
    "languages": [
      {
        "id": "avalang",
        "aliases": [
          "AvaLang",
          "avalang"
        ],
        "extensions": [
          ".ava"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/file-icon.svg",
          "dark": "./icons/file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "avalang",
        "scopeName": "source.avalang",
        "path": "./syntaxes/avalang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "avalang",
        "path": "./snippets/avalang.json"
      }
    ],
    "configurationDefaults": {
      "[avalang]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    },
    "commands": [
      {
        "command": "avalang.runFile",
        "title": "AvaLang: Run File",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "avalang.runFile",
          "when": "resourceLangId == avalang",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "avalang.runFile",
          "when": "resourceLangId == avalang"
        }
      ]
    },
    "keybindings": [
      {
        "command": "avalang.runFile",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == avalang"
      }
    ],
    "configuration": {
      "title": "AvaLang",
      "properties": {
        "avalang.executablePath": {
          "type": "string",
          "default": "ava_cli",
          "scope": "resource",
          "description": "Path to the ava_cli executable used by \"AvaLang: Run File\" (F5 / play button). Can be just the name if it's on the PATH (e.g. \"ava_cli\"), or an absolute/relative path (e.g. \"/path/to/avalang/build_cli/runtime/avalang/Release/ava_cli\" or \"C:/path/to/avalang/build_cli/runtime/avalang/Release/ava_cli.exe\"). Supports ${workspaceFolder} and ${fileDirname}."
        },
        "avalang.workingDirectory": {
          "type": "string",
          "default": "${fileDirname}",
          "scope": "resource",
          "description": "Working directory ava_cli is launched from. Supports ${workspaceFolder}, ${fileDirname}, ${fileBasename}, ${fileBasenameNoExtension}, ${file}. Defaults to the folder of the .ava file being run."
        },
        "avalang.modulesPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional override for the modules/ folder (equivalent to ava_cli's --modules flag / the AVA_MODULES_PATH environment variable). Empty = use ava_cli's default (modules/ next to the executable)."
        },
        "avalang.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "resource",
          "description": "Extra arguments appended after the script (available in AvaLang as the global `args` list)."
        },
        "avalang.clearTerminalBeforeRun": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Clear the AvaLang terminal before each run with F5 / the play button."
        }
      }
    }
  }
}
