  },
  "system-environment-setvar": {
    "prefix": "System.Environment.SetEnvironmentVariable",
    "body": [
      "System.Environment.SetEnvironmentVariable(${1:name}, ${2:value})"
    ],
    "description": "System.Environment.SetEnvironmentVariable(name, value)"
  },
  "system-environment-getcwd": {
    "prefix": "System.Environment.GetCurrentDirectory",
    "body": [
