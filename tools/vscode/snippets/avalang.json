{
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:condition} then",
      "\t$0",
      "end"
    ],
    "description": "if ... then ... end"
  },
  "if-else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} then",
      "\t$2",
      "else",
      "\t$0",
      "end"
    ],
    "description": "if ... then ... else ... end"
  },
  "if-elif-else": {
    "prefix": "ifelif",
    "body": [
      "if ${1:condition} then",
      "\t$2",
      "elif ${3:condition} then",
      "\t$4",
      "else",
      "\t$0",
      "end"
    ],
    "description": "if ... then ... elif ... then ... else ... end"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:condition}",
      "\t$0",
      "end"
    ],
    "description": "while ... end"
  },
  "for-in": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:iterable} then",
      "\t$0",
      "end"
    ],
    "description": "for ... in ... then ... end"
  },
  "func": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:params})",
      "\t$0",
      "end"
    ],
    "description": "func ... end"
  },
  "async-func": {
    "prefix": "asyncfunc",
    "body": [
      "async func ${1:name}(${2:params})",
      "\t$0",
      "end"
    ],
    "description": "async func ... end (AvaLang.g4: asyncFuncDeclaration)"
  },
  "await-expr": {
    "prefix": "await",
    "body": [
      "await ${0:expr}"
    ],
    "description": "await expr -- solo valido dentro de un async func (awaitAtom)"
  },
  "static-func": {
    "prefix": "staticfunc",
    "body": [
      "static func ${1:name}(${2:params})",
      "\t$0",
      "end"
    ],
    "description": "static func ... end (modifiedFuncDeclaration)"
  },
  "private-func": {
    "prefix": "privatefunc",
    "body": [
      "private func ${1:name}(${2:params})",
      "\t$0",
      "end"
    ],
    "description": "private func ... end (modifiedFuncDeclaration)"
  },
  "func-typed": {
    "prefix": "functyped",
    "body": [
      "func ${1:name}(${2:a as int}) as ${3:int}",
      "\t$0",
      "end"
    ],
    "description": "func name(param as Type) as ReturnType ... end (AvaLang_Plan_Sistema_de_Tipos.md)"
  },
  "var-typed": {
    "prefix": "astype",
    "body": [
      "${1:name} as ${2:int} = ${0:value}"
    ],
    "description": "name as Type = value -- anotacion de tipo explicita"
  },
  "var-typed-decl": {
    "prefix": "astypedecl",
    "body": [
      "${1:name} as ${2:int}"
    ],
    "description": "name as Type -- declaracion sin inicializar"
  },
  "local-typed": {
    "prefix": "localtyped",
    "body": [
      "local ${1:name} as ${2:int} = ${0:value}"
    ],
    "description": "local name as Type = value -- fuerza declaracion nueva (shadow) en el scope actual"
  },
  "class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}",
      "\t$0",
      "end"
    ],
    "description": "class ... end"
  },
  "class-heritage": {
    "prefix": "classext",
    "body": [
      "class ${1:Name}: ${2:Parent}",
      "\t$0",
      "end"
    ],
    "description": "class Name: Parent ... end"
  },
  "try-catch": {
    "prefix": "try",
    "body": [
      "try",
      "\t$1",
      "catch (${2:err})",
      "\t$0",
      "end"
    ],
    "description": "try ... catch (err) ... end"
  },
  "try-catch-finally": {
    "prefix": "tryf",
    "body": [
      "try",
      "\t$1",
      "catch (${2:err})",
      "\t$3",
      "finally",
      "\t$0",
      "end"
    ],
    "description": "try ... catch (err) ... finally ... end"
  },
  "select-case": {
    "prefix": "select",
    "body": [
      "select ${1:expr}",
      "\tcase ${2:value} then",
      "\t\t$0",
      "\telse",
      "\t\t",
      "end"
    ],
    "description": "select ... case ... then ... else ... end (VB6-style switch)"
  },
  "extern": {
    "prefix": "extern",
    "body": [
      "extern \"${1:libname}\" as ${2:Alias}",
      "\tfunc ${0:name}(${3:params})",
      "end"
    ],
    "description": "extern \"lib\" as Alias ... end"
  },
  "extern-typed": {
    "prefix": "externtyped",
    "body": [
      "extern \"${1:libname}\" as ${2:Alias}",
      "\tfunc ${0:name}(${3:a as int}) as ${4:int}",
      "end"
    ],
    "description": "extern \"lib\" as Alias func name(param as Type) as ReturnType ... end (AvaLang_Plan_Sistema_de_Tipos.md, Fase 16)"
  },
  "lambda": {
    "prefix": "lambda",
    "body": [
      "(${1:params}) => $0"
    ],
    "description": "short lambda expression"
  },
  "lambda-typed": {
    "prefix": "lambdatyped",
    "body": [
      "(${1:x as int}) as ${2:int} => $0"
    ],
    "description": "(param as Type) as ReturnType => expr -- lambda con tipos (AvaLang_Plan_Sistema_de_Tipos.md, Fase 14)"
  },
  "fstring": {
    "prefix": "fstring",
    "body": [
      "$\"${1:text}{${0:expr}}\""
    ],
    "description": "f-string with interpolation"
  },

  "import-system": {
    "prefix": "import.system",
    "body": [
      "import system"
    ],
    "description": "import system (Console, DateTime, Environment, IO, Diagnostics)"
  },
  "system-console-write": {
    "prefix": "System.Console.Write",
    "body": [
      "System.Console.Write(${1:text})"
    ],
    "description": "System.Console.Write(text)"
  },
  "system-console-writeline": {
    "prefix": "System.Console.WriteLine",
    "body": [
      "System.Console.WriteLine(${1:text})"
    ],
    "description": "System.Console.WriteLine(text)"
  },
  "system-console-writeerror": {
    "prefix": "System.Console.WriteError",
    "body": [
      "System.Console.WriteError(${1:text})"
    ],
    "description": "System.Console.WriteError(text)"
  },
  "system-console-readline": {
    "prefix": "System.Console.ReadLine",
    "body": [
      "System.Console.ReadLine()"
    ],
    "description": "System.Console.ReadLine() -- nil on EOF"
  },
  "system-console-foregroundcolor": {
    "prefix": "System.Console.ForegroundColor",
    "body": [
      "System.Console.ForegroundColor(System.Console.Colors.${1|Default,Black,Red,Green,Yellow,Blue,Magenta,Cyan,White|})"
    ],
    "description": "System.Console.ForegroundColor(colorName) -- returns false on bad color name"
  },
  "system-console-resetcolor": {
    "prefix": "System.Console.ResetColor",
    "body": [
      "System.Console.ResetColor()"
    ],
    "description": "System.Console.ResetColor()"
  },
  "system-datetime-now": {
    "prefix": "System.DateTime.Now",
    "body": [
      "System.DateTime.Now()"
    ],
    "description": "System.DateTime.Now() -- Dict{Year,Month,Day,Hour,Minute,Second,Millisecond,DayOfWeek,Ticks}"
  },
  "system-datetime-utcnow": {
    "prefix": "System.DateTime.UtcNow",
    "body": [
      "System.DateTime.UtcNow()"
    ],
    "description": "System.DateTime.UtcNow()"
  },
  "system-datetime-tostring": {
    "prefix": "System.DateTime.ToString",
    "body": [
      "System.DateTime.ToString(${1:dt})"
    ],
    "description": "System.DateTime.ToString(dt) -- ISO 8601 (YYYY-MM-DDTHH:MM:SS.mmmZ)"
  },
  "system-datetime-sleep": {
    "prefix": "System.DateTime.Sleep",
