errors = 0
ok = 0
round2 = 0
while (round2 < 3)
    for idx in range(5) then
        try
            if idx == round2 then
                raise "skip"
            end
            ok = ok + 1
        catch (e)
            errors = errors + 1
        end
    end
    round2 = round2 + 1
end
print("ok=" + str(ok))
print("errors=" + str(errors))
print("round2=" + str(round2))
print("=== DONE ===")
