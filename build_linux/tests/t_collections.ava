print("=== listas ===")
l = [1, 2, 3, 4, 5]
print(l)
print("len: " + str(len(l)))
print("first: " + str(l[0]))
print("last: " + str(l[4]))
l[0] = 100
print("modif: " + str(l[0]))
l.append(6)
print("append: " + str(len(l)))
print("contains 3: " + str(l.contains(3)))

print("=== iteracion lista ===")
total = 0
for x in l then
    total = total + x
end
print("sum for: " + str(total))
print("sum builtin: " + str(sum(l)))

print("=== range ===")
r = range(5)
print(r)
print("range(2,7): " + str(range(2, 7)))
print("range(0,10,2): " + str(range(0, 10, 2)))

print("=== slice ===")
s = [10, 20, 30, 40, 50]
print("slice [1:3]: " + str(s[1:3]))
print("slice [:2]: " + str(s[:2]))
print("slice [3:]: " + str(s[3:]))

print("=== dict ===")
d = {name: "Ada", age: 36}
print(d)
print("name: " + d["name"])
print("age: " + str(d["age"]))
d["lang"] = "AvaLang"
print("keys len: " + str(len(d)))
d["age"] = 37
print("modif age: " + str(d["age"]))

print("=== iteracion dict ===")
for k in d then
    print(k + " => " + str(d[k]))
end

print("=== DONE ===")
