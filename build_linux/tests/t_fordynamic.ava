func check(name, got, expected)
    if got == expected then
        print("[OK] " + name)
    else
        print("[FAIL] " + name + " -> esperado=" + str(expected) + " actual=" + str(got))
    end
end

print("=== for sobre coroutine en variable ===")
func gen()
    yield 1
    yield 2
    yield 3
end

g = coroutine(gen)
vals = []
for v in g then
    vals = vals + [v]
end
check("coroutine for", vals, [1, 2, 3])

print("=== for sobre lista en variable ===")
l = [10, 20, 30]
s = 0
for x in l then
    s = s + x
end
check("list for", s, 60)

print("=== for sobre dict en variable ===")
d = {"a": 1, "b": 2, "c": 3}
keys = []
for k in d then
    keys = keys + [k]
end
check("dict for count", len(keys), 3)

print("=== for sobre string ===")
acc = ""
for ch in "xyz" then
    acc = acc + ch
end
check("string for", acc, "xyz")

print("=== for sobre range directo ===")
total = 0
for i in range(5) then
    total = total + i
end
check("range for", total, 10)

print("=== DONE ===")
