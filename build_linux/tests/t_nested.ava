func check(name, got, expected)
    if got == expected then
        print("[OK] " + name)
    else
        print("[FAIL] " + name + " -> esperado=" + str(expected) + " actual=" + str(got))
    end
end

print("=== 1. WHILE CON IF ANIDADO ===")
i = 0
evens = 0
odds = 0
while (i < 10)
    if i % 2 == 0 then
        evens = evens + 1
    else
        odds = odds + 1
    end
    i = i + 1
end
check("while+if evens", evens, 5)
check("while+if odds", odds, 5)
check("while counter", i, 10)

print("=== 2. IF DENTRO DE IF (3 niveles) ===")
func classify(n)
    if n > 0 then
        if n > 10 then
            if n > 100 then
                return "big"
            else
                return "medium"
            end
        else
            return "small"
        end
    else
        if n == 0 then
            return "zero"
        else
            return "negative"
        end
    end
end
check("nested if big", classify(500), "big")
check("nested if medium", classify(50), "medium")
check("nested if small", classify(5), "small")
check("nested if zero", classify(0), "zero")
check("nested if negative", classify(-3), "negative")

print("=== 3. WHILE DENTRO DE FOR ===")
total = 0
for k in range(5) then
    j = 0
    while (j < 3)
        total = total + 1
        j = j + 1
    end
end
check("for+while total", total, 15)

print("=== 4. FOR DENTRO DE WHILE ===")
acc = 0
w = 0
while (w < 3)
    for x in range(4) then
        acc = acc + x
    end
    w = w + 1
end
check("while+for acc", acc, 18)

print("=== 5. BREAK DENTRO DE WHILE DENTRO DE FOR ===")
found = -1
for row in range(5) then
    col = 0
    while (col < 5)
        if row * col == 6 then
            found = row * 10 + col
            break
        end
        col = col + 1
    end
    if found != -1 then
        break
    end
end
check("break nested", found, 23)

print("=== 6. CONTINUE EN WHILE ===")
cnt = 0
n = 0
while (n < 20)
    n = n + 1
    if n % 3 == 0 then
        continue
    end
    cnt = cnt + 1
end
check("continue in while", cnt, 14)

print("=== 7. BREAK Y CONTINUE MEZCLADOS EN FOR ===")
result = []
for k in range(20) then
    if k % 2 == 0 then
        continue
    end
    if k > 10 then
        break
    end
    result = result.append(k)
end
check("break+continue for", result, [1, 3, 5, 7, 9])

print("=== 8. FOR COROUTINE DENTRO DE WHILE ===")
func gen2()
    yield 100
    yield 200
    yield 300
end
sum_coro = 0
rounds = 0
while (rounds < 2)
    g = coroutine(gen2)
    for v in g then
        sum_coro = sum_coro + v
    end
    rounds = rounds + 1
end
check("coro in while", sum_coro, 1200)
check("coro rounds", rounds, 2)

print("=== 9. FOR LIST DENTRO DE IF DENTRO DE WHILE ===")
collected = []
stop = false
iter = 0
while (not stop)
    iter = iter + 1
    if iter > 3 then
        stop = true
    else
        for x in [iter * 10, iter * 10 + 1] then
            collected = collected.append(x)
        end
    end
end
check("for-in-if-in-while", collected, [10, 11, 20, 21, 30, 31])
check("iter count", iter, 4)

print("=== 10. IF/ELIF/ELSE EN CADENA ===")
func grade(score)
    if score >= 90 then
        return "A"
    elif score >= 80 then
        return "B"
    elif score >= 70 then
        return "C"
    elif score >= 60 then
        return "D"
    else
        return "F"
    end
end
check("grade A", grade(95), "A")
check("grade B", grade(85), "B")
check("grade C", grade(75), "C")
check("grade D", grade(65), "D")
check("grade F", grade(55), "F")

print("=== 11. WHILE ANIDADO (matriz) ===")
rowsum = []
r = 0
while (r < 3)
    s = 0
    c = 0
    while (c < 3)
        s = s + (r * 3 + c)
        c = c + 1
    end
    rowsum = rowsum.append(s)
    r = r + 1
end
check("nested while rows", rowsum, [3, 12, 21])

print("=== 12. FOR CON IF Y CONTINUE DENTRO DE WHILE ===")
kept = []
wi = 0
while (wi < 5)
    for val in range(wi * 2, wi * 2 + 3) then
        if val % 2 != 0 then
            continue
        end
        kept = kept.append(val)
    end
    wi = wi + 1
end
check("for+if+continue in while", kept, [0, 2, 2, 4, 4, 6, 6, 8, 8, 10])

print("=== 13. COROUTINE CON BREAK ===")
func countdown()
    yield 5
    yield 4
    yield 3
    yield 2
    yield 1
end
hits = 0
for n in coroutine(countdown) then
    if n == 2 then
        break
    end
    hits = hits + 1
end
check("coro break", hits, 3)

print("=== 14. TRY DENTRO DE FOR DENTRO DE WHILE ===")
errors = 0
ok = 0
round2 = 0
while (round2 < 3)
    for idx in range(5) then
        try
            if idx == round2 then
                raise "skip"
            end
            ok = ok + 1
        catch (e)
            errors = errors + 1
        end
    end
    round2 = round2 + 1
end
check("try-in-for-in-while ok", ok, 12)
check("try-in-for-in-while errors", errors, 3)

print("=== 15. VARIABLE COROUTINE CON CONTINUE ===")
func mixed()
    yield 1
    yield 2
    yield 3
    yield 4
    yield 5
end
cg = coroutine(mixed)
odd_sum = 0
for num in cg then
    if num % 2 == 0 then
        continue
    end
    odd_sum = odd_sum + num
end
check("coro variable continue", odd_sum, 9)

print("=== DONE ===")
