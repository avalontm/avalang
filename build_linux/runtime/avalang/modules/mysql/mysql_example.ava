import mysql

func install(db)
    if db.tableExists("users") then
        print("users table already exists, skipping install")
        return
    end
    db.execute("create table users (id int auto_increment primary key, name varchar(100), active tinyint(1) default 1)")
    print("users table created")
end

func main()
    db = MySQL()

    db.connect("127.0.0.1", "root", "", "test", 3306)
    print("connected, server: " + db.serverInfo())

    if db.isConnected() then
        print("connection status: ok")
    end

    install(db)

    id1 = db.insert("users", {name: "Ada", active: true})
    id2 = db.insert("users", {name: "Grace", active: true})
    print("inserted, ids: " + str(id1) + ", " + str(id2))

    rows = db.fetchAll("select id, name, active from users where active = ?", [true])
    print("total active: " + str(len(rows)))
    for row in rows then
        print(row["id"] + " -> " + row["name"])
    end

    ada = db.fetchOne("select * from users where name = ?", ["Ada"])
    if ada != nil then
        print("found by name: " + ada["name"])
    end

    total = db.count("users", "active = ?", [true])
    print("count() active: " + str(total))

    db.update("users", {name: "Ada Lovelace"}, "id = ?", [id1])
    print("exists with new name: " + str(db.exists("users", "name = ?", ["Ada Lovelace"])))

    db.begin()
    db.update("users", {active: false}, "id = ?", [id2])
    db.commit()
    print("Grace deactivated, active rows now: " + str(db.count("users", "active = ?", [true])))

    db.delete("users", "id = ?", [id1])
    db.delete("users", "id = ?", [id2])

    db.close()
    print("connection closed, status: " + db.state)
end

main()
