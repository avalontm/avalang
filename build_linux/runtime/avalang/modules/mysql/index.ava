# MySQL binding for AvaLang, over libmysql.dll (MySQL C client) via `extern` FFI.
# Copy this folder (index.ava + libmysql.dll) to `modules/mysql/` next to the
# executable you use (AvaStudio.exe or ava_cli.exe) so `import mysql` resolves.

extern "libmysql" as MySQLNative
    func mysql_init(mysql)
    func mysql_real_connect(mysql, host, user, passwd, db, port, unix_socket, clientflag)
    func mysql_query(mysql, query)
    func mysql_error(mysql)
    func mysql_errno(mysql)
    func mysql_ping(mysql)
    func mysql_select_db(mysql, db)
    func mysql_get_server_info(mysql)
    func mysql_store_result(mysql)
    func mysql_field_count(mysql)
    func mysql_num_rows(res)
    func mysql_num_fields(res)
    func mysql_fetch_row(res)
    func mysql_fetch_field(res)
    func mysql_fetch_field_direct(res, fieldnr)
    func mysql_free_result(res)
    func mysql_close(mysql)
    func mysql_affected_rows(mysql)
    func mysql_insert_id(mysql)
end

class MySQL
    handle = nil
    connected = false
    state = "idle"
    lastError = nil

    _host = nil
    _user = nil
    _passwd = nil
    _db = nil
    _port = 3306

    func MySQL()
        this.handle = MySQLNative.mysql_init(nil)
        this.connected = false
        this.state = "idle"
    end

    func connect(host, user, passwd, db, port)
        p = port
        if p == nil then
            p = 3306
        end

        this._host = host
        this._user = user
        this._passwd = passwd
        this._db = db
        this._port = p

        this.state = "connecting"
        result = MySQLNative.mysql_real_connect(this.handle, host, user, passwd, db, p, nil, 0)
        if mem_is_null(result) then
            this.connected = false
            this.state = "error"
            this.lastError = this.error()
            raise "mysql: could not connect (" + host + "): " + this.lastError
        end

        this.connected = true
        this.state = "connected"
        this.lastError = nil
        return this
    end

    func reconnect()
        if this.connected then
            this.close()
        end
        this.handle = MySQLNative.mysql_init(nil)
        return this.connect(this._host, this._user, this._passwd, this._db, this._port)
    end

    # ping() never clears `connected` on failure -- it can false-negative
    # (timeout, unsupported ping, etc.) without the connection actually
    # being dead. Call reconnect() explicitly if you want to act on it.
    func ping()
        if not this.connected then
            return false
        end
        rc = MySQLNative.mysql_ping(this.handle)
        if rc == 0 then
            this.state = "connected"
            return true
        end
        this.state = "error"
        this.lastError = this.error()
        return false
    end

    func isConnected(fresh)
        check = fresh
        if check == nil then
            check = true
        end
        if not this.connected then
            return false
        end
        if check then
            return this.ping()
        end
        return true
    end

    func selectDb(db)
        this.ensureConnected()
        rc = MySQLNative.mysql_select_db(this.handle, db)
        if rc != 0 then
            raise "mysql: could not select database '" + db + "': " + this.error()
        end
        this._db = db
        return true
    end

    func serverInfo()
        this.ensureConnected()
        ptr = MySQLNative.mysql_get_server_info(this.handle)
        if mem_is_null(ptr) then
            return "unknown (mysql_get_server_info returned NULL)"
        end
        return mem_peek_string(ptr)
    end

    func error()
        return mem_peek_string(MySQLNative.mysql_error(this.handle))
    end

    func errno()
        return MySQLNative.mysql_errno(this.handle)
    end

    func ensureConnected()
        if not this.connected then
            raise "mysql: no active connection -- call connect() first (or reconnect() if it dropped)"
        end
    end

    # --- Query ----------------------------------------------------------

    func query(sql, params)
        this.ensureConnected()

        h = this.handle
        finalSql = this._bindParams(sql, params)
        rc = MySQLNative.mysql_query(h, finalSql)
        if rc != 0 then
            code = this.errno()
            if code == 2006 or code == 2013 then
                this.connected = false
                this.state = "error"
            end
            this.lastError = this.error()
            raise "mysql: query error: " + this.lastError + " -- sql: " + finalSql
        end

        rows = []
        columns = []

        fieldCount = MySQLNative.mysql_field_count(h)
        if fieldCount > 0 then
            res = MySQLNative.mysql_store_result(h)
            if not mem_is_null(res) then
                cols = MySQLNative.mysql_num_fields(res)
                columns = this._fieldNames(res, cols)

                while true
                    row = MySQLNative.mysql_fetch_row(res)
                    if mem_is_null(row) then
                        break
                    end

                    record = {}
                    i = 0
                    while i < cols
                        cell = mem_peek_ptr(row, i)
                        value = nil
                        if not mem_is_null(cell) then
                            value = mem_peek_string(cell)
                        end
                        record[columns[i]] = value
                        i = i + 1
                    end
                    rows.append(record)
                end

                MySQLNative.mysql_free_result(res)
            end
        end

        result = {}
        result["rows"] = rows
        result["columns"] = columns
        result["affectedRows"] = MySQLNative.mysql_affected_rows(this.handle)
        result["insertId"] = MySQLNative.mysql_insert_id(this.handle)
        return result
    end

    # --- Read shortcuts ---------------------------------------------------

    func fetchAll(sql, params)
        result = this.query(sql, params)
        return result["rows"]
    end

    func fetchOne(sql, params)
        rows = this.fetchAll(sql, params)
        if len(rows) == 0 then
            return nil
        end
        return rows[0]
    end

    func fetchValue(sql, params)
        row = this.fetchOne(sql, params)
        if row == nil then
            return nil
        end
        pairs = row.items()
        if len(pairs) == 0 then
            return nil
        end
        return pairs[0][1]
    end

    func fetchColumn(sql, params, columnName)
        rows = this.fetchAll(sql, params)
        out = []
        i = 0
        while i < len(rows)
            pairs = rows[i].items()
            j = 0
            found = false
            while j < len(pairs)
                if pairs[j][0] == columnName then
                    out.append(pairs[j][1])
                    found = true
                    break
                end
                j = j + 1
            end
            if not found then
                out.append(nil)
            end
            i = i + 1
        end
        return out
    end

    func execute(sql, params)
        result = this.query(sql, params)
        return result["affectedRows"]
    end

    func lastInsertId()
        return MySQLNative.mysql_insert_id(this.handle)
    end

    # --- CRUD shortcuts ---------------------------------------------------

    func insert(table, data)
        pairs = data.items()
        cols = []
        values = []
        i = 0
        while i < len(pairs)
            cols.append(pairs[i][0])
            values.append(pairs[i][1])
            i = i + 1
        end

        sql = "insert into " + table + " (" + this._joinIdentifiers(cols) + ") values (" + this._placeholders(len(cols)) + ")"
        result = this.query(sql, values)
        return result["insertId"]
    end

    func update(table, data, whereSql, whereParams)
        pairs = data.items()
        setSql = ""
        values = []
        i = 0
        while i < len(pairs)
            if i > 0 then
                setSql = setSql + ", "
            end
            setSql = setSql + pairs[i][0] + " = ?"
            values.append(pairs[i][1])
            i = i + 1
        end

        sql = "update " + table + " set " + setSql
        if whereSql != nil then
            sql = sql + " where " + whereSql
            if whereParams != nil then
                j = 0
                while j < len(whereParams)
                    values.append(whereParams[j])
                    j = j + 1
                end
            end
        end

        result = this.query(sql, values)
        return result["affectedRows"]
    end

    func delete(table, whereSql, whereParams)
        sql = "delete from " + table
        if whereSql != nil then
            sql = sql + " where " + whereSql
        end
        result = this.query(sql, whereParams)
        return result["affectedRows"]
    end

    func count(table, whereSql, whereParams)
        sql = "select count(*) as total from " + table
        if whereSql != nil then
            sql = sql + " where " + whereSql
        end
        row = this.fetchOne(sql, whereParams)
        if row == nil then
            return 0
        end
        return int(row["total"])
    end

    func exists(table, whereSql, whereParams)
        return this.count(table, whereSql, whereParams) > 0
    end

    # true if `table` exists in the currently selected schema.
    func tableExists(table)
        this.ensureConnected()
        row = this.fetchOne("select count(*) as total from information_schema.tables where table_schema = database() and table_name = ?", [table])
        if row == nil then
            return false
        end
        return int(row["total"]) > 0
    end

    # --- Transactions -----------------------------------------------------

    func begin()
        this.execute("START TRANSACTION")
        return this
    end

    func commit()
        this.execute("COMMIT")
        return this
    end

    func rollback()
        this.execute("ROLLBACK")
        return this
    end

    # --- Internal helpers ---------------------------------------------

    func escape(value)
        return str(value).replace("'", "''")
    end

    func close()
        if this.connected then
            MySQLNative.mysql_close(this.handle)
            this.connected = false
            this.state = "closed"
        end
    end

    func _quote(value)
        if value == nil then
            return "NULL"
        end

        t = type(value)
        if t == "bool" then
            if value then
                return "1"
            end
            return "0"
        end
        if t == "number" then
            return str(value)
        end

        return "'" + this.escape(value) + "'"
    end

    func _bindParams(sql, params)
        if params == nil then
            return sql
        end

        out = ""
        pi = 0
        i = 0
        n = len(sql)
        while i < n
            c = sql.substring(i, i + 1)
            if c == "?" then
                if pi >= len(params) then
                    raise "mysql: query has more '?' than parameters (" + str(len(params)) + " given): " + sql
                end
                out = out + this._quote(params[pi])
                pi = pi + 1
            else
                out = out + c
            end
            i = i + 1
        end

        if pi != len(params) then
            raise "mysql: " + str(len(params)) + " parameters were passed but the query only has " + str(pi) + " '?': " + sql
        end
        return out
    end

    # MYSQL_FIELD has `char *name` as its first struct member, so
    # mem_peek_ptr(field, 0) gives the name pointer the same way
    # mem_peek_ptr(row, i) gives a MYSQL_ROW cell pointer.
    #
    # Usamos mysql_fetch_field_direct(res, i) en vez del iterador
    # mysql_fetch_field(res): el iterador mantiene estado interno en
    # MYSQL_RES y se puede desincronizar si algo lo toca entre llamadas
    # (o si el binding FFI le pasa un handle corrupto). _direct(res, i)
    # es stateless: dame el campo #i, punto. Mas predecible para
    # diagnosticar nulls en los nombres de columna.
    func _fieldNames(res, cols)
        names = []
        i = 0
        while i < cols
            field = MySQLNative.mysql_fetch_field_direct(res, i)
            name = "col" + str(i)
            if not mem_is_null(field) then
                namePtr = mem_peek_ptr(field, 0)
                if not mem_is_null(namePtr) then
                    name = mem_peek_string(namePtr)
                end
            end
            names.append(name)
            i = i + 1
        end
        return names
    end

    func _joinIdentifiers(names)
        out = ""
        i = 0
        while i < len(names)
            if i > 0 then
                out = out + ", "
            end
            out = out + names[i]
            i = i + 1
        end
        return out
    end

    func _placeholders(n)
        out = ""
        i = 0
        while i < n
            if i > 0 then
                out = out + ", "
            end
            out = out + "?"
            i = i + 1
        end
        return out
    end
end
