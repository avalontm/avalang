print("=== Bug: OpAdd string + bool ===")
print("true=" + true)
print("false=" + false)
print("nil=" + nil)

print("")
print("=== Bug: str(list) consistente ===")
print("str([1,2,3]) = " + str([1,2,3]))
print("str([\"a\",\"b\"]) = " + str(["a","b"]))
print("str([true,false,nil]) = " + str([true,false,nil]))

print("")
print("=== Bug: comparacion de listas ===")
print("[1,2] == [1,2]: " + str([1,2] == [1,2]))
print("[\"a\"] == [\"a\"]: " + str(["a"] == ["a"]))
print("[1,2] == [1,3]: " + str([1,2] == [1,3]))

print("")
print("=== Bug: comparacion de dicts ===")
print("{a:1} == {a:1}: " + str({a:1} == {a:1}))

print("")
print("=== str + number ===")
