import mysql

func main()
    db = MySQL()
    db.connect("127.0.0.1", "root", "", "test", 3306)
    print("connected, server: " + db.serverInfo())

    db.execute("drop table if exists probe_users")
    db.execute("create table probe_users (id int auto_increment primary key, name varchar(50), active tinyint(1))")

    id1 = db.insert("probe_users", {name: "Ada", active: true})
    print("insert via db.insert(dict): id=" + str(id1))

    row = db.fetchOne("select name, active from probe_users where id = ?", [id1])
    if row == nil then
        print("FAIL: fetchOne by [id1] returned nil")
    else
        print("fetchOne by [id1]: name=" + str(row["name"]) + " active=" + str(row["active"]))
    end

    name_var = "Ada"
    row2 = db.fetchOne("select name, active from probe_users where name = ?", [name_var])
    if row2 == nil then
        print("FAIL: fetchOne by [name_var] returned nil (binding de variable roto)")
    else
        print("fetchOne by [name_var]: name=" + str(row2["name"]) + " active=" + str(row2["active"]))
    end

    rows = db.fetchAll("select name, active from probe_users where active = ?", [true])
    print("fetchAll by [true]: " + str(len(rows)) + " filas")

    db.execute("drop table probe_users")
    db.close()
    print("done, state=" + db.state)
end
main()
