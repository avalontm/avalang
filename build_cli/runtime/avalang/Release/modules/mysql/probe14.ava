class C
    func _bindParams(sql, params)
        if params == nil then
            return sql
        end
        print("[after if] type(params)=" + type(params) + " len=" + str(len(params)))
        print("[after if] params[0]=" + str(params[0]))
        return "ok"
    end
    func testA(values)
        return this._bindParams("(?, ?)", values)
    end
end
func main()
    c = C()
    print("A: " + c.testA(["Ada", true]))
end
main()
