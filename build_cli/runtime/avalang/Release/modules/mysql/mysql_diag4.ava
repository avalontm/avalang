import mysql

class Diag
    handle = nil

    func Diag()
        this.handle = MySQLNative.mysql_init(nil)
    end

    func connect(host, user, passwd, db, port)
        r = MySQLNative.mysql_real_connect(this.handle, host, user, passwd, db, port, nil, 0)
        print("connect result (class): " + str(r))
        print("is same as handle: " + str(r == this.handle))
        print("is null: " + str(mem_is_null(r)))
        print("errno: " + str(MySQLNative.mysql_errno(this.handle)))
        print("error: " + mem_peek_string(MySQLNative.mysql_error(this.handle)))
    end
end

func main()
    d = Diag()
    print("init handle: " + str(d.handle))
    d.connect("127.0.0.1", "root", "", "test", 3306)
end

main()
