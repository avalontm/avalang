import mysql

class Diag2
    handle = nil
    state = "idle"
    _host = nil
    _user = nil
    _passwd = nil
    _db = nil
    _port = 3306

    func Diag2()
        this.handle = MySQLNative.mysql_init(nil)
    end

    func connectA(host, user, passwd, db, port)
        r = MySQLNative.mysql_real_connect(this.handle, host, user, passwd, db, port, nil, 0)
        return r
    end

    func connectB(host, user, passwd, db, port)
        p = port
        if p == nil then
            p = 3306
        end
        r = MySQLNative.mysql_real_connect(this.handle, host, user, passwd, db, p, nil, 0)
        return r
    end

    func connectC(host, user, passwd, db, port)
        this._host = host
        this._user = user
        this._passwd = passwd
        this._db = db
        this._port = port
        r = MySQLNative.mysql_real_connect(this.handle, host, user, passwd, db, port, nil, 0)
        return r
    end

    func connectD(host, user, passwd, db, port)
        this._host = host
        this._user = user
        this._passwd = passwd
        this._db = db
        this._port = port
        this.state = "connecting"
        r = MySQLNative.mysql_real_connect(this.handle, host, user, passwd, db, port, nil, 0)
        return r
    end
end

func report(label, r, h)
    print(label + ": is_null=" + str(mem_is_null(r)) + " errno=" + str(MySQLNative.mysql_errno(h)))
end

func main()
    a = Diag2()
    report("A bare", a.connectA("127.0.0.1", "root", "", "test", 3306), a.handle)

    b = Diag2()
    report("B plus p", b.connectB("127.0.0.1", "root", "", "test", 3306), b.handle)

    c = Diag2()
    report("C plus field writes", c.connectC("127.0.0.1", "root", "", "test", 3306), c.handle)

    d = Diag2()
    report("D plus state write", d.connectD("127.0.0.1", "root", "", "test", 3306), d.handle)
end

main()
