import mysql

func main()
    db = MySQL()
    print("handle after init: " + str(db.handle))

    db.connect("127.0.0.1", "root", "", "test", 3306)
    print("handle after connect: " + str(db.handle))
    print("errno after connect: " + str(db.errno()))
    print("error after connect: " + db.error())

    rc = db.execute("drop table if exists diag_t")
    print("drop rc/affectedRows: " + str(rc))
    print("errno after drop: " + str(db.errno()))

    rc2 = db.execute("create table diag_t (id int auto_increment primary key, v int)")
    print("create rc/affectedRows: " + str(rc2))
    print("errno after create: " + str(db.errno()))

    result = db.query("insert into diag_t (v) values (42)")
    print("insert affectedRows: " + str(result["affectedRows"]))
    print("insert insertId: " + str(result["insertId"]))
    print("errno after insert: " + str(db.errno()))

    result2 = db.query("select id, v from diag_t")
    print("select columns: " + str(len(result2["columns"])))
    print("select rows: " + str(len(result2["rows"])))
    print("errno after select: " + str(db.errno()))

    db.close()
end

main()
