class C
    func _bindParams(extra, sql, params)
        if params == nil then
            return sql
        end
        print("[probe16] type(params)=" + type(params) + " len=" + str(len(params)) + " params[0]=" + str(params[0]))
        return "ok"
    end
    func testA(values)
        return this._bindParams(99, "(?, ?)", values)
    end
end
func main()
    c = C()
    print("probe16 (3 params, params al final): " + c.testA(["Ada", true]))
end
main()
