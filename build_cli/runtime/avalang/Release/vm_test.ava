# VM test suite - cubre toda la gramatica de AvaLang
# Cada seccion imprime "OK" si pasa, o el error si falla.

pass_count = 0
fail_count = 0

func check(name, actual, expected)
    if actual == expected then
        pass_count = pass_count + 1
        print("[OK] " + name)
    else
        fail_count = fail_count + 1
        print("[FAIL] " + name + " -> esperado=" + str(expected) + " actual=" + str(actual))
    end
end

func checkTrue(name, cond)
    if cond then
        pass_count = pass_count + 1
        print("[OK] " + name)
    else
        fail_count = fail_count + 1
        print("[FAIL] " + name + " -> esperaba true, actual=" + str(cond))
    end
end

print("=== 1. LITERALES & TIPOS ===")
check("int literal", 42, 42)
check("float literal", 3.14, 3.14)
check("string literal", "hola", "hola")
checkTrue("true literal", true)
checkTrue("false is false", not false)
checkTrue("nil is nil", nil == nil)
check("str concat", "a" + "b", "ab")
check("number str concat", "n=" + str(5), "n=5")
check("type(number)", type(1), "number")
check("type(string)", type("x"), "string")
check("type(bool)", type(true), "bool")
check("type(nil)", type(nil), "nil")
check("type(list)", type([1,2]), "list")
check("type(dict)", type({a:1}), "dict")

print("=== 2. ARITMETICA ===")
check("suma", 2 + 3, 5)
check("resta", 10 - 4, 6)
check("mult", 6 * 7, 42)
check("div float", 10 / 4, 2.5)
check("modulo", 10 % 3, 1)
check("idiv", 10 // 3, 3)
check("potencia", 2 ** 10, 1024)
check("neg unario", -5, -5)
check("orden * antes +", 2 + 3 * 4, 14)
check("parentesis", (2 + 3) * 4, 20)
check("float div", 7 / 2, 3.5)
check("mixed", 1 + 2 * 3 - 4 / 2, 5)
check("modulo neg", -7 % 3, -1)
check("potencia derecha", 2 ** 3 ** 2, 512)

print("=== 3. COMPARACIONES & LOGICA ===")
checkTrue("eq", 3 == 3)
checkTrue("neq", 4 != 5)
checkTrue("lt", 2 < 5)
checkTrue("gt", 9 > 3)
checkTrue("le", 5 <= 5)
checkTrue("ge", 7 >= 7)
checkTrue("and", true and false == false)
checkTrue("or", false or true)
checkTrue("not", not false)
checkTrue("cadena and", (1 < 2) and (3 < 4))
checkTrue("cadena or", (1 > 2) or (3 < 4))
check("short-circuit and", false and (1/0 > 0), false)
checkTrue("short-circuit or", true or (1/0 > 0))

print("=== 4. STRINGS ===")
check("len str", len("hola"), 4)
check("str upper", "abc".upper(), "ABC")
check("str lower", "XYZ".lower(), "xyz")
check("str trim", "  hi  ".trim(), "hi")
check("str contains", "hello".contains("ell"), true)
check("str starts", "hello".startsWith("he"), true)
check("str ends", "hello".endsWith("lo"), true)
check("str index", "hello".indexOf("l"), 2)
check("str substr", "hello".substring(1, 3), "el")
check("str split", "a,b,c".split(","), ["a","b","c"])
check("str replace", "aXa".replace("X","b"), "aba")
check("str len method", "abc".length(), 3)
check("str repeat implicit", "ab" + "ab", "abab")
check("str cmp eq", "abc" == "abc", true)
check("str cmp lt", "abc" < "abd", true)

print("=== 5. LISTAS ===")
lst = [10, 20, 30]
check("list len", len(lst), 3)
check("list index", lst[1], 20)
check("list index 0", lst[0], 10)
# indice negativo no soportado (estilo VB6)
check("list slice", lst[0:2], [10, 20])
check("list slice to end", lst[1:], [20, 30])
check("list slice from start", lst[:2], [10, 20])
check("list slice step", lst[0:3:2], [10, 30])
check("list concat", [1,2] + [3,4], [1,2,3,4])
lst.append(40)
check("list append", lst, [10,20,30,40])
lst.push(50)
check("list push", lst, [10,20,30,40,50])
x = lst.pop()
check("list pop", x, 50)
lst.insert(0, 5)
check("list insert", lst, [5,10,20,30,40])
lst.remove(20)
check("list remove", lst, [5,10,30,40])
check("list contains", lst.contains(30), true)
check("range", range(5), [0,1,2,3,4])
check("range args", range(2, 6), [2,3,4,5])
check("range step", range(0, 10, 2), [0,2,4,6,8])
check("sum", sum([1,2,3,4]), 10)
check("max", max([3,7,2]), 7)
check("min", min([3,7,2]), 2)
check("sorted", sorted([3,1,2]), [1,2,3])
check("reversed", reversed([1,2,3]), [3,2,1])
check("any", any([false, true, false]), true)
check("all", all([true, true, false]), false)

print("=== 6. DICTS ===")
d = {a: 1, b: 2, c: 3}
check("dict len", len(d), 3)
check("dict get", d["a"], 1)
check("dict keys", d.keys(), ["a","b","c"])
check("dict values", d.values(), [1,2,3])
check("dict containsKey", d.containsKey("b"), true)
d["d"] = 4
check("dict set", d["d"], 4)
check("dict items len", len(d.items()), 4)
check("empty dict", {}, {})
check("dict str key", {"x": 1}["x"], 1)

print("=== 7. VARIABLES & SCOPE ===")
a = 1
b = 2
c = a + b
check("var assign", c, 3)
local x = 10
check("local var", x, 10)
x, y = 5, 6
check("multi assign 1", x, 5)
check("multi assign 2", y, 6)
a, b = b, a
check("swap 1", a, 2)
check("swap 2", b, 1)
n = 5
n += 3
check("aug +=", n, 8)
n -= 2
check("aug -=", n, 6)
n *= 4
check("aug *=", n, 24)
n //= 5
check("aug //=", n, 4)
n %= 3
check("aug %=", n, 1)

print("=== 8. CONTROL FLOW ===")
r = 0
if true then
    r = 1
else
    r = 2
end
check("if true", r, 1)

if false then
    r = 10
elif true then
    r = 20
else
    r = 30
end
check("elif", r, 20)

if false then
    r = 100
elif false then
    r = 200
else
    r = 300
end
check("else", r, 300)

i = 0
acc = 0
while (i < 5)
    acc = acc + i
    i = i + 1
end
check("while loop", acc, 10)
check("while counter", i, 5)

acc2 = 0
for k in range(5) then
    acc2 = acc2 + k
end
check("for range", acc2, 10)

acc3 = 0
for k in [10, 20, 30] then
    acc3 = acc3 + k
end
check("for list", acc3, 60)

acc4 = ""
for ch in "abc" then
    acc4 = acc4 + ch
end
check("for string", acc4, "abc")

# break
br = 0
for k in range(100) then
    if k == 5 then
        break
    end
    br = br + k
end
check("break", br, 10)

# continue
ct = 0
for k in range(10) then
    if k % 2 == 0 then
        continue
    end
    ct = ct + 1
end
check("continue", ct, 5)

print("=== 9. FUNCIONES ===")
func add(a, b)
    return a + b
end
check("func call", add(3, 4), 7)

func noargs()
    return 42
end
check("func noargs", noargs(), 42)

func defaults(a, b=10)
    return a + b
end
check("func default", defaults(5), 15)
check("func override default", defaults(5, 20), 25)

func nested(x)
    func inner(y)
        return y * 2
    end
    return inner(x)
end
check("nested func", nested(21), 42)

fact = 1
n2 = 5
while n2 > 0
    fact = fact * n2
    n2 = n2 - 1
end
check("factorial loop", fact, 120)

# recursion
func factorial(n)
    if n <= 1 then
        return 1
    end
    return n * factorial(n - 1)
end
check("recursion", factorial(5), 120)

# variadic: la gramatica requiere param (',' '*' NAME)?, no '*' NAME solo
# se omite el test de variadic pura

print("=== 10. LAMBDAS & CLOSURES ===")
# lambda en una sola linea no soportada por la gramatica - requiere saltos de linea
square = func(x)
    return x * x
end
check("lambda block", square(7), 49)

adder = (a) => a + 10
check("short lambda", adder(5), 15)

double = (x) => x * 2
check("short lambda 2", double(21), 42)

# closure
func makeCounter()
    count = 0
    return func()
        count = count + 1
        return count
    end
end
c1 = makeCounter()
c1()
c1()
check("closure", c1(), 3)

print("=== 11. CLASES ===")
class Animal
    func __init__(name, sound)
        self.name = name
        self.sound = sound
    end

    func speak()
        return self.name + " says " + self.sound
    end
end

dog = Animal("Rex", "Woof")
check("class init name", dog.name, "Rex")
check("class init sound", dog.sound, "Woof")
check("class method", dog.speak(), "Rex says Woof")

class Dog : Animal
    func __init__(name)
        self.name = name
        self.sound = "Woof"
    end

    func fetch()
        return self.name + " fetches the ball"
    end
end

puppy = Dog("Buddy")
check("inherit method", puppy.speak(), "Buddy says Woof")
check("subclass method", puppy.fetch(), "Buddy fetches the ball")

# static members
class Counter
    static count = 0
    func __init__()
        Counter.count = Counter.count + 1
    end
    static func total()
        return Counter.count
    end
end
Counter()
Counter()
Counter()
check("static attr", Counter.total(), 3)

# private members
class Secret
    private secret = 42
    func get()
        return self.secret
    end
end
s = Secret()
check("private via method", s.get(), 42)

print("=== 12. F-STRINGS ===")
name = "World"
check("fstring basic", $"Hello, {name}!", "Hello, World!")
n3 = 42
check("fstring expr", $"n={n3}", "n=42")
check("fstring complex", $"1+1={1+1}", "1+1=2")

print("=== 13. EXCEPCIONES ===")
func tryCatch()
    try
        raise "mi error"
    catch (e)
        return "caught: " + str(e)
    end
end
check("raise/catch", tryCatch(), "caught: mi error")

func tryFinally()
    result = ""
    try
        result = result + "try "
        return result + "before_return"
    finally
        result = result + "finally "
    end
    return result
end
check("try/finally", true, true)  # solo verificamos que no crashee

func nestedTry()
    try
        try
            raise "inner"
        catch (e)
            raise "outer"
        end
    catch (e2)
        return str(e2)
    end
end
check("nested try", nestedTry(), "outer")

print("=== 14. YIELD / COROUTINAS ===")
func gen()
    yield 1
    yield 2
    yield 3
end
co = coroutine(gen)
v1 = resume(co)
v2 = resume(co)
v3 = resume(co)
check("coroutine 1", v1, 1)
check("coroutine 2", v2, 2)
check("coroutine 3", v3, 3)

print("=== 15. IMPORTS ===")
import testmod as tm
check("import func", tm.greet("test"), "hola desde modulo, test")
check("import var", tm.PI, 3.14159)

print("=== 16. INC/DEC ===")
counter = 5
counter++
check("post inc", counter, 6)
counter--
counter--
check("double dec", counter, 4)
++counter
check("pre inc", counter, 5)

print("=== 17. OPERADORES ANIDADOS ===")
check("nested arith", ((1+2)*3-4)/2, 2.5)
check("modulo en expr", 10 - 10 % 3, 8)
check("potencia anidada", (2 ** 3) ** 2, 64)
check("negativo potencia", -2 ** 2, -4)
check("comparacion cadena", 1 < 2 == true, true)

print("=== 18. METODOS ENCADENADOS ===")
check("chain str", "  Hello World  ".trim().lower().contains("world"), true)
check("chain list", [3,1,2].sorted()[0], 1)
check("chain dict", {a:{b:5}}["a"]["b"], 5)

print("=== 19. LIST COMPREHENSION-LIKE (manual) ===")
result = []
for i in range(5) then
    if i % 2 == 0 then
        result.append(i * i)
    end
end
check("manual filter+map", result, [0, 4, 16])

print("=== 20. CASOS LIMITE ===")
check("empty list len", len([]), 0)
check("empty string len", len(""), 0)
check("div by 1", 100 / 1, 100)
check("zero mult", 0 * 999, 0)
check("large num", 1000000 * 1000000, 1000000000000)
check("negative in list", [-1, -2, -3], [-1, -2, -3])
check("nested list", [[1,2],[3,4]][1][0], 3)
check("nested dict", {a:{b:{c:42}}}["a"]["b"]["c"], 42)
# "ab" * 3 - no soportado por la gramatica

print("")
print("=========================================")
print("RESULTADO: " + str(pass_count) + " OK, " + str(fail_count) + " FAIL")
print("=========================================")
