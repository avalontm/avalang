extern "c" as LibC
    func abs(n)
    func atoi(s)
end

import testmod as tm

func main()
    print("=== test linux backend ===")
    print("1. print basic funciona")
    print("2. print con varios args:", 1, true, "texto")

    name = input("3. input prompt - escribe tu nombre: ")
    print("   hola, " + name + "!")

    print("4. extern FFI (libc.so.6 via dlopen):")
    r = LibC.abs(-42)
    print("   abs(-42) = " + str(r))
    n = LibC.atoi("123")
    print("   atoi(\"123\") = " + str(n))

    print("5. import de modulo local:")
    g = tm.greet("avalang")
    print("   " + g)
    print("   tm.PI = " + str(tm.PI))

    print("6. set_timeout (async via LinTimer + LinThread):")
    set_timeout(func()
        print("   timer disparado tras 100ms")
    end, 100)
    print("   timer agendado, esperando...")

    print("7. str/len/range builtins:")
    print("   len(\"hola\") = " + str(len("hola")))
    print("   range(3) = " + str(range(3)))
    print("   type(42) = " + str(type(42)))

    print("=== test completo ===")
end
main()
