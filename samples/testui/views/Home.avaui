clicks = 0
agreed = true
planBasic = true
planPro = false

func OnSubmitClick()
    clicks++
end

view
    Column
        padding = 20
        gap = 16

        Text
            text = $"clicks: {clicks}"
            textColor = "#333333"
            fontSize = 18
            fontName = "Segoe UI"
        end
        TextBox
            backgroundColor = "#FFFFFF"
            borderColor = "#A4A4A4"
            borderWidth = 1
            fontSize = 12
            placeholder = "TEXTO AQUI"
        end
        CheckBox
            label = "Acepto los términos"
            checked = {agreed}
            borderColor = "#CCCCCC"
            borderWidth = 1
        end
        Text
            text = $"agreed: {agreed}"
            textColor = "#666666"
            fontSize = 12
            fontName = "Segoe UI"
        end
        RadioButton
            label = "Plan Basico"
            selected = {planBasic}
            group = "plan"
            borderColor = "#CCCCCC"
            borderWidth = 1
        end
        RadioButton
            label = "Plan Pro"
            selected = {planPro}
            group = "plan"
            borderColor = "#CCCCCC"
            borderWidth = 1
        end
        Button
            borderColor = "#CCCCCC"
            text = "Enviar"
            backgroundColor = "#0078D4"
            fontSize = 14
            textColor = "#FFFFFF"
            borderWidth = 5
            fontName = "Segoe UI"
            borderRadius = 10
            onClick = {OnSubmitClick}
        end
        Text
            text = $"plan: {planBasic ? "basico" : (planPro ? "pro" : "ninguno")}"
            textColor = "#666666"
            fontSize = 12
            fontName = "Segoe UI"
        end
        Image
            borderRadius = 4
        end
        ComboBox
            backgroundColor = "#FFFFFF"
            borderColor = "#A4A4A4"
            borderWidth = 1
            fontSize = 12
            isOpen = false
        end
        Text
            fontSize = 12
            textColor = "#333333"
            fontName = "Segoe UI"
        end
        Text
            fontSize = 12
            textColor = "#333333"
            fontName = "Segoe UI"
        end
    end
end
