state
    clicks = 0
    agreed = true
    planBasic = true
    planPro = false
end

view
    Column
        padding = 20
        spacing = 16
        gap = 16

        Text
            text = "\\\"test - clicks: \\\" + clicks"
            fontSize = 18
            textColor = 333333
            fontName = "Segoe UI"
        end
        TextBox
            backgroundColor = "FFFFFF"
            borderColor = "A4A4A4"
            fontSize = 12
            borderWidth = 1
        end
        CheckBox
            label = "Acepto los términos"
            borderColor = "CCCCCC"
            isChecked = "agreed"
            borderWidth = 1
        end
        Text
            text = "\\\"agreed: \\\" + agreed"
            fontSize = 12
            textColor = 666666
            fontName = "Segoe UI"
        end
        RadioButton
            label = "Plan Basico"
            group = "plan"
            isSelected = "planBasic"
            borderColor = "CCCCCC"
            borderWidth = 1
        end
        RadioButton
            label = "Plan Pro"
            group = "plan"
            isSelected = "planPro"
            borderColor = "CCCCCC"
            borderWidth = 1
        end
        Button
            text = "Enviar"
            backgroundColor = "0078D4"
            borderWidth = 5
            textColor = "FFFFFF"
            fontSize = 12
            fontName = "Segoe UI"
            borderRadius = 10
            borderColor = "#CCCCCC"
            click = OnSubmitClick()
        end
        Text
            text = "\\\"plan: \\\" + (planBasic ? \\\"basico\\\" : (planPro ? \\\"pro\\\" : \\\"ninguno\\\"))"
            fontSize = 12
            textColor = 666666
            fontName = "Segoe UI"
        end
        Image
            borderRadius = 4
        end
        ComboBox
            backgroundColor = "FFFFFF"
            borderColor = "A4A4A4"
            isOpen = false
            fontSize = 12
            borderWidth = 1
        end
        Text
            textColor = 333333
            fontSize = 12
            fontName = "Segoe UI"
        end
        Text
            textColor = 333333
            fontSize = 12
            fontName = "Segoe UI"
        end
    end
end

code
    func OnSubmitClick()
        clicks++
    end
end
