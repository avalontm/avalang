view
    column
        padding = 16
        gap = 12
        borderWidth = 1
        borderColor = "E5E7EB"
        backgroundColor = "FFFFFF"
        margin = 0

        text
            text = "AvaHost"
            fontSize = 18
            align = "center"
            # See desktop Navbar.avaui for why wrap+width, not just
            # align, is what actually prevents the ellipsis clip.
            wrap = true
            width = 320
        end

        row
            gap = 16
            align = "center"

            link
                text = "Home"
                href = "/"
                textColor = "2563EB"
            end

            link
                text = "About"
                href = "/about"
                textColor = "2563EB"
            end
        end
    end
end
