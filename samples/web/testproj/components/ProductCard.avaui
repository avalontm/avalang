params
    name
    price
    productId
end

view
    container
        padding = 5
        gap = 8

        column
            gap = 8

            text
                text = name
                fontSize = 16
                wrap = true
            end

            text
                text = "$" + price
                style = "text.price"
                wrap = true
            end

            button
                text = "Agregar"
                click = OnAddToCart(productId)
            end
        end
    end
end
