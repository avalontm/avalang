extends layouts.main

properties
    title = "POS - Inicio"
end

view
    column
        padding = 48
        gap = 24
        align = "center"

        text
            text = "Punto de Venta"
            fontName = "heading1"
            fontSize = 32
        end

        text
            text = "Sistema de ventas para cafe y panaderia."
            style = "text.muted"
            fontSize = 16
        end

        button
            id = "StartPosBtn"
            text = "Iniciar POS"
            fontSize = 18
            padding = 16
        end

        link
            text = "Ir directamente al POS >"
            href = "/pos"
            textColor = "2563EB"
            fontSize = 16
        end
    end
end
