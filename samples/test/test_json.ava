import json

g_n = 0
g_fails = 0

func check(n, expected, actual)
    if expected == actual then
        print("OK " + str(n))
        return true
    end
    print("FAIL " + str(n) + ": esperado=" + str(expected) + " real=" + str(actual))
    return false
end

func mark(ok)
    g_n = g_n + 1
    if not ok then
        g_fails = g_fails + 1
    end
end

func raisesDecode(s)
    try
        decode(s)
        return false
    catch (e)
        return true
    end
end

print("== Decode escalares ==")

mark(check(g_n + 1, 42, decode("42")))
mark(check(g_n + 1, 3.5, decode("3.5")))
mark(check(g_n + 1, -7, decode("-7")))
mark(check(g_n + 1, 250, decode("2.5e2")))
mark(check(g_n + 1, 0.01, decode("1e-2")))
mark(check(g_n + 1, "hola", decode("\"hola\"")))
mark(check(g_n + 1, true, decode("true")))
mark(check(g_n + 1, false, decode("false")))
mark(check(g_n + 1, nil, decode("null")))
mark(check(g_n + 1, "nil", type(decode("null"))))

print("== Decode strings con escapes ==")

mark(check(g_n + 1, "a\nb", decode("\"a\\nb\"")))
mark(check(g_n + 1, "tab\tfin", decode("\"tab\\tfin\"")))
mark(check(g_n + 1, "quo\"te", decode("\"quo\\\"te\"")))
mark(check(g_n + 1, "back\\slash", decode("\"back\\\\slash\"")))
mark(check(g_n + 1, "slash/", decode("\"slash\\/\"")))
mark(check(g_n + 1, "AB", decode("\"\\u0041B\"")))
mark(check(g_n + 1, "A\t", decode("\"A\\u0009\"")))
mark(check(g_n + 1, char(8), decode("\"\\b\"")))
mark(check(g_n + 1, char(12), decode("\"\\f\"")))

e9 = decode("\"\\u00e9\"")
mark(check(g_n + 1, 2, len(e9)))
mark(check(g_n + 1, 195, charCode(e9[0])))
mark(check(g_n + 1, 169, charCode(e9[1])))

print("== Decode compuestos ==")

lst = decode("[1, 2, 3]")
mark(check(g_n + 1, 3, len(lst)))
mark(check(g_n + 1, 1, lst[0]))
mark(check(g_n + 1, 3, lst[2]))

lstw = decode("  [ 1 , 2 ]  ")
mark(check(g_n + 1, 2, len(lstw)))
mark(check(g_n + 1, 2, lstw[1]))

d = decode("{\"a\": 1, \"b\": \"x\"}")
mark(check(g_n + 1, 1, d["a"]))
mark(check(g_n + 1, "x", d["b"]))
mark(check(g_n + 1, 2, len(keys(d))))

nested = decode("{\"l\": [{\"x\": 1}, true], \"s\": \"h\n\"}")
mark(check(g_n + 1, 1, nested["l"][0]["x"]))
mark(check(g_n + 1, true, nested["l"][1]))
mark(check(g_n + 1, "h\n", nested["s"]))

empty_d = decode("{}")
empty_l = decode("[]")
mark(check(g_n + 1, "dict", type(empty_d)))
mark(check(g_n + 1, 0, len(keys(empty_d))))
mark(check(g_n + 1, "list", type(empty_l)))
mark(check(g_n + 1, 0, len(empty_l)))

print("== Decode errores ==")

mark(check(g_n + 1, true, raisesDecode("")))
mark(check(g_n + 1, true, raisesDecode("truex")))
mark(check(g_n + 1, true, raisesDecode("{\"a\"}")))
mark(check(g_n + 1, true, raisesDecode("[1 2]")))
mark(check(g_n + 1, true, raisesDecode("{\"a\": 1,")))
mark(check(g_n + 1, true, raisesDecode("\"sin cierre")))
mark(check(g_n + 1, true, raisesDecode("\"\\q\"")))

print("== Encode ==")

mark(check(g_n + 1, "42", encode(42)))
mark(check(g_n + 1, "3.5", encode(3.5)))
mark(check(g_n + 1, "-0.25", encode(-0.25)))
mark(check(g_n + 1, "100000", encode(100000)))
mark(check(g_n + 1, "\"hi\"", encode("hi")))
mark(check(g_n + 1, "\"a\\nb\"", encode("a\nb")))
mark(check(g_n + 1, "\"quo\\\"te\"", encode("quo\"te")))
mark(check(g_n + 1, "\"back\\\\slash\"", encode("back\\slash")))
mark(check(g_n + 1, "\"\\b\"", encode(char(8))))
mark(check(g_n + 1, "\"\\f\"", encode(char(12))))
mark(check(g_n + 1, "\"\\u0001\"", encode(char(1))))
mark(check(g_n + 1, "null", encode(nil)))
mark(check(g_n + 1, "true", encode(true)))
mark(check(g_n + 1, "false", encode(false)))
mark(check(g_n + 1, "[1,\"a\",null,true]", encode([1, "a", nil, true])))
mark(check(g_n + 1, "[]", encode([])))
mark(check(g_n + 1, "{}", encode({})))

print("== Round-trips ==")

mark(check(g_n + 1, "{\"a\":1,\"b\":\"x\"}", encode(decode("{\"a\": 1, \"b\": \"x\"}"))))

src1 = "{\"name\":\"ana\",\"age\":30,\"tags\":[\"a\",\"b\"],\"ok\":true,\"none\":null,\"pi\":3.14}"
mark(check(g_n + 1, src1, encode(decode(src1))))

deep = decode("{\"a\": [1, {\"b\": [true, null, \"z\"]}]}")
mark(check(g_n + 1, "{\"a\":[1,{\"b\":[true,null,\"z\"]}]}", encode(deep)))

weird = "tab\tnl\nq\"bs\\"
mark(check(g_n + 1, weird, decode(encode(weird))))
mark(check(g_n + 1, e9, decode(encode(e9))))

big = decode("[0, -1, 1000000, 0.001, \"x\", [true], {}]")
mark(check(g_n + 1, "[0,-1,1000000,0.001,\"x\",[true],{}]", encode(big)))

mark(check(g_n + 1, 0, mem_leak_count()))

print("")
print("RESULTADO: " + str(g_n) + " checks, " + str(g_fails) + " FAIL")
if g_fails > 0 then
    raise "TEST JSON FALLIDO: " + str(g_fails) + " checks en rojo"
end
print("TEST JSON: TODO OK")