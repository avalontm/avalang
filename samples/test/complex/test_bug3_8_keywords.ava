func check(n, expected, actual)
    if expected == actual then
        print("OK " + str(n))
    else
        print("FAIL " + str(n) + ": esperado=" + str(expected) + " real=" + str(actual))
    end
end

to = 10
step = 2
check(1, 10, to)
check(2, 2, step)

sum = 0
for i = 0 to 5 then
    sum = sum + i
end
check(3, 15, sum)

sum2 = 0
for i = 0 to 10 step 3 then
    sum2 = sum2 + i
end
check(4, 18, sum2)

count = 0
for i = 10 to 0 step -2 then
    count = count + 1
end
check(5, 6, count)

func addto(a, to)
    return a + to
end
check(6, 7, addto(3, 4))

func withstep(step)
    return step * 2
end
check(7, 8, withstep(4))

d = {"to": 1, "step": 2}
check(8, 1, d["to"])
check(9, 2, d["step"])

for to = 1 to 3 then
    sum = sum + to
end
check(10, 21, sum)

total = 0
for step = 1 to 4 then
    total = total + step
end
check(11, 10, total)

x = 75
hit = 0
select x
    case 0 to 50 then
        hit = 1
    case 51 to 100 then
        hit = 2
    else
        hit = 3
end
check(12, 2, hit)

y = 25
hit2 = 0
select y
    case 0 to 50 then
        hit2 = 1
    else
        hit2 = 3
end
check(13, 1, hit2)
