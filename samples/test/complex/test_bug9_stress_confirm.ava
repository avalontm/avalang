# test_bug9_stress_confirm.ava
# Pruebas complejas de confirmacion del fix de BUG 9: mutacion de
# variables de nivel modulo dentro de funciones en multiples patrones:
#   * funcion cuyo ultimo statement es asignacion a global
#   * mutacion de global acumulador/contador
#   * mutacion de dict y array global
#   * mutacion de global como ultimo statement de WHILE y FOR
#   * multiples funciones que mutan el mismo estado global

import lib.stress.registry
import lib.stress.logger

func check(n, expected, actual)
    if expected == actual then
        print("OK " + str(n))
    else
        print("FAIL " + str(n) + ": esperado=" + str(expected) + " real=" + str(actual))
    end
end

# --- 1. Ultimo statement = asignacion a global (caso exacto del fix) ---
lib.stress.registry.clear()
lib.stress.registry.add_item(10)
lib.stress.registry.add_item(20)
lib.stress.registry.add_item(30)
check(1, 3, lib.stress.registry.get_total())
check(2, 60, lib.stress.registry.get_cost())
check(3, 3, lib.stress.registry.get_registry_size())

# --- 2. clear() tambien termina en asignacion a global ---
lib.stress.registry.clear()
check(4, 0, lib.stress.registry.get_total())
check(5, 0, lib.stress.registry.get_cost())
check(6, 0, lib.stress.registry.get_calls())
check(7, 0, lib.stress.registry.get_last())

# --- 3. Global mutado como ultimo statement de un WHILE ---
lib.stress.registry.clear()
lib.stress.registry.sum_even(10)
# while 0..10 inclusive = 11 iteraciones
check(8, 11, lib.stress.registry.get_total())

# --- 4. Global mutado como ultimo statement de un FOR ---
lib.stress.registry.clear()
lib.stress.registry.fill_ids(4)
# for j=0..4 : 5 iteraciones, last_id += 1 cada una
check(9, 5, lib.stress.registry.get_last())
check(10, 5, lib.stress.registry.get_ids_len())

# --- 5. Buffer global acumulado via append en funcion ---
lib.stress.registry.clear()
lib.stress.registry.add_item(5)
lib.stress.registry.add_item(7)
lib.stress.registry.fill_ids(2)   # +3 ids
lib.stress.registry.sum_even(4)   # +5 iteraciones
# total_items: 2 (add_item) + 0 (fill_ids no toca total) + 5 (sum_even)
check(11, 7, lib.stress.registry.get_total())
# ids_seen: 2 de add_item + 3 de fill_ids
check(12, 5, lib.stress.registry.get_ids_len())

# --- 6. Segundo modulo: logger ---
lib.stress.logger.log_info("inicio")
lib.stress.logger.log_error("fallo A")
lib.stress.logger.log_event("warn", "nuevo")
lib.stress.logger.log_info("fin")
check(13, 4, lib.stress.logger.get_log_len())
check(14, 3, lib.stress.logger.get_events())
check(15, 1, lib.stress.logger.get_errors())
check(16, "[INFO] inicio", lib.stress.logger.get_first())
check(17, "[INFO] fin", lib.stress.logger.get_last())

# --- 7. Estado global compartido entre funciones del MISMO modulo ---
lib.stress.registry.clear()
lib.stress.registry.add_item(100)  # last_id -> 1, total_items -> 1
lib.stress.registry.sum_even(2)    # 0,1,2 -> 3 iteraciones, total_items -> 4
# last_id sigue siendo 1 porque sum_even no lo toca; fill_ids lo incrementa
lib.stress.registry.fill_ids(1)    # 2 iteraciones, last_id -> 3
check(18, 4, lib.stress.registry.get_total())
check(19, 3, lib.stress.registry.get_last())
check(20, 100, lib.stress.registry.get_cost())

# --- 8. get_cost() debe persistir el acumulado del paso 7 ---
lib.stress.registry.add_item(1)   # total_cost = 101, total_items = 5
check(21, 101, lib.stress.registry.get_cost())
check(22, 5, lib.stress.registry.get_total())

print("=== test_bug9_stress_confirm.ava terminado ===")
