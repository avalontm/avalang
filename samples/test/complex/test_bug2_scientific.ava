func check(n, expected, actual)
    if expected == actual then
        print("OK " + str(n))
    else
        print("FAIL " + str(n) + ": esperado=" + str(expected) + " real=" + str(actual))
    end
end

check(1, 0.000000001, 1e-9)
check(2, 2500000, 2.5e6)
check(3, 0.03, 3E-2)
check(4, 1500, 1.5e+3)
check(5, 3000, 1e3 + 2e3)
check(6, 2, 2e0)
check(7, 0.5, 5e-1)
check(8, 100, 1e2)
check(9, true, 1e-9 < 0.000001)
check(10, 1000000, 1E6)
arr = [1e2, 2e2]
check(11, 100, arr[0])
check(12, 200, arr[1])
d = {"x": 5e-1}
check(13, 0.5, d["x"])
total = 0.0
for i = 0 to 2 then
    total = total + 1e3
end
check(14, 3000, total)
