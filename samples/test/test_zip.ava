import zip
import hex

g_n = 0
g_fails = 0

func check(n, expected, actual)
    if expected == actual then
        print("OK " + str(n))
        return true
    end
    print("FAIL " + str(n) + ": esperado=" + str(expected) + " real=" + str(actual))
    return false
end

func mark(ok)
    g_n = g_n + 1
    if not ok then
        g_fails = g_fails + 1
    end
end

func binString(bytes)
    buf = mem_alloc(len(bytes))
    mem_write_bytes(buf, 0, bytes)
    s = mem_string(buf, 0, len(bytes))
    mem_free(buf)
    return s
end

hex1 = "504b030414000000000000002100c2412435030000000300000008000000736f6c6f2e747874616263504b0102140014000000000000002100c24124350300000003000000080000000000000000000000800100000000736f6c6f2e747874504b0506000000000100010036000000290000000000"
hex3 = ""

print("== Interop escritura (fixture Python) ==")

z1 = writeEntries([["solo.txt", "abc"]])
mark(check(g_n + 1, hex1, encode(z1)))

data64 = binString(range(0, 64))
z3 = writeEntries([["hola.txt", "hola mundo"], ["data.bin", data64], ["vacio.txt", ""]])
mark(check(g_n + 1, hex3, encode(z3)))

print("== Interop lectura (fixture Python) ==")

r1 = readEntries(decode(hex1))
mark(check(g_n + 1, 1, len(r1)))
mark(check(g_n + 1, "solo.txt", r1[0][0]))
mark(check(g_n + 1, "abc", r1[0][1]))

r3 = readEntries(decode(hex3))
mark(check(g_n + 1, 3, len(r3)))
mark(check(g_n + 1, "hola.txt", r3[0][0]))
mark(check(g_n + 1, "hola mundo", r3[0][1]))
mark(check(g_n + 1, "data.bin", r3[1][0]))
mark(check(g_n + 1, data64, r3[1][1]))
mark(check(g_n + 1, "vacio.txt", r3[2][0]))
mark(check(g_n + 1, "", r3[2][1]))

print("== Round-trips propios ==")

bin256 = binString(range(0, 256))
entries = [["a.txt", "alfa"], ["b.bin", bin256], ["c.txt", ""]]
rt = readEntries(writeEntries(entries))
mark(check(g_n + 1, 3, len(rt)))
mark(check(g_n + 1, "a.txt", rt[0][0]))
mark(check(g_n + 1, "alfa", rt[0][1]))
mark(check(g_n + 1, bin256, rt[1][1]))
mark(check(g_n + 1, "", rt[2][1]))

empty = readEntries(writeEntries([]))
mark(check(g_n + 1, 0, len(empty)))

print("== Errores ==")

func raisesIt(f)
    try
        f()
        return false
    catch (e)
        return true
    end
end

func corruptCrc()
    z = writeEntries([["a.txt", "alfa"]])
    bad = z.substring(0, 14) + char(255) + z.substring(15, len(z))
    readEntries(bad)
end

func unsupportedMethod()
    z = writeEntries([["a.txt", "alfa"]])
    bad = z.substring(0, 8) + char(8) + z.substring(9, len(z))
    readEntries(bad)
end

mark(check(g_n + 1, true, raisesIt(corruptCrc)))
mark(check(g_n + 1, true, raisesIt(unsupportedMethod)))

mark(check(g_n + 1, 0, mem_leak_count()))

print("")
print("RESULTADO: " + str(g_n) + " checks, " + str(g_fails) + " FAIL")
if g_fails > 0 then
    raise "TEST ZIP FALLIDO: " + str(g_fails) + " checks en rojo"
end
print("TEST ZIP: TODO OK")