import hex

g_n = 0
g_fails = 0

func check(n, expected, actual)
    if expected == actual then
        print("OK " + str(n))
        return true
    end
    print("FAIL " + str(n) + ": esperado=" + str(expected) + " real=" + str(actual))
    return false
end

func mark(ok)
    g_n = g_n + 1
    if not ok then
        g_fails = g_fails + 1
    end
end

func binString(bytes)
    buf = mem_alloc(len(bytes))
    mem_write_bytes(buf, 0, bytes)
    s = mem_string(buf, 0, len(bytes))
    mem_free(buf)
    return s
end

print("== Vectores estandar ==")

mark(check(g_n + 1, "", encode("")))
mark(check(g_n + 1, "", decode("")))
mark(check(g_n + 1, "68656c6c6f", encode("hello")))
mark(check(g_n + 1, "hello", decode("68656c6c6f")))
mark(check(g_n + 1, "Hello", decode("48656C6C6F")))
mark(check(g_n + 1, "48454c4c4f", encode("HELLO")))
mark(check(g_n + 1, "000f10ff", encode(binString([0, 15, 16, 255]))))
mark(check(g_n + 1, binString([0, 15, 16, 255]), decode("000f10ff")))
mark(check(g_n + 1, 10, len(encode("hello"))))
mark(check(g_n + 1, nil, decode("abc")))
mark(check(g_n + 1, nil, decode("0g")))

print("== Binario / full range ==")

full = binString(range(0, 256))
mark(check(g_n + 1, 512, len(encode(full))))
mark(check(g_n + 1, full, decode(encode(full))))
mark(check(g_n + 1, "", encode(full)))

mark(check(g_n + 1, 0, mem_leak_count()))

print("")
print("RESULTADO: " + str(g_n) + " checks, " + str(g_fails) + " FAIL")
if g_fails > 0 then
    raise "TEST HEX FALLIDO: " + str(g_fails) + " checks en rojo"
end
print("TEST HEX: TODO OK")