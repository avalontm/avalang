# Test del "async/await" de avalang.
#
# avalang no tiene 'async'/'await' como keywords del lenguaje: en vez de
# eso expone un scheduler de bajo nivel (Fase 5, ver
# runtime/avalang/src/builtins/builtin_async.cpp) sobre corrutinas
# cooperativas (yield/resume). El patron equivalente a "await" es:
#
#   co = coroutine(worker)   # crear la corrutina
#   resume(co)                # correrla hasta el primer yield
#   sleep_async(co, ms)       # avalang la resume sola despues del delay
#
# ava_cli mantiene el proceso vivo hasta que no queden timers pendientes
# (ver api/src/main.cpp, HasPendingAsyncWork/PumpAsyncEvents), igual que
# el event loop de Node -- no hace falta bloquear a mano.

print("=== 1) set_timeout basico ===")

func saludoDemorado()
    print("  hola despues de 200ms")
end

print("antes de agendar")
set_timeout(saludoDemorado, 200)
print("despues de agendar (esto imprime ANTES que el saludo)")


print("")
print("=== 2) orden de varios timers (deben correr por delay, no por orden de registro) ===")

func tick(etiqueta)
    return func()
        print($"  tick {etiqueta}")
    end
end

set_timeout(tick("C (300ms)"), 300)
set_timeout(tick("A (50ms)"), 50)
set_timeout(tick("B (150ms)"), 150)


print("")
print("=== 3) clear_timeout -- DESACTIVADO: bug real encontrado, ver reporte ===")
print("=== builtin_clear_timeout() cancela el timer del PAL pero nunca llama")
print("=== OnAsyncTimerConsumed() para ese handle -> el contador de timers")
print("=== pendientes de la VM nunca vuelve a 0 -> ava_cli queda colgado para")
print("=== siempre despues de este punto (confirmado con timeout). No lo")
print("=== ejercitamos aca para que el resto del test corra. ===")


print("")
print("=== 4) coroutine + yield + sleep_async (el 'await' real) ===")

func worker()
    print("  worker: antes del yield")
    yield
    print("  worker: retomo despues del delay -- esto es el 'await'")
    yield
    print("  worker: segundo tramo, tambien tras un delay")
end

co = coroutine(worker)
resume(co)                 # corre hasta el primer yield (sincronico)
print("  main: segui corriendo mientras el worker esta 'esperando'")
sleep_async(co, 250)        # reanuda el worker solo, 250ms despues

print("")
print("=== fin del script principal -- ava_cli deberia seguir vivo ===")
print("=== hasta drenar todos los timers/coroutines pendientes ===")
