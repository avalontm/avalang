import System
import Memory.readMemory

nombreExe = "target.exe"
health = 0x00E5F000

try
    pid = BuscarPidPorNombre(nombreExe)
    print($"{nombreExe} encontrado, PID = {pid}")

    i = 0
    while i < 20
        puntaje = LeerInt32(pid, health)
        print($"Puntaje actual: {puntaje}")
        Thread.Sleep(500)
        i++
    end
catch (err)
    print($"Error: {err}")
end
