func calificacion(nota)
    select nota
        case 90 to 100 then
            return "A"
        case 80, 85, 89 then
            return "B"
        case is >= 60 then
            return "C"
        else
            return "F"
    end
end

print(calificacion(95))
print(calificacion(85))
print(calificacion(89))
print(calificacion(65))
print(calificacion(10))

dia = "sab"
select dia
    case "sab", "dom" then
        print("finde")
    case "lun" then
        print("arranca la semana")
    else
        print("dia normal")
end

# discriminante con side effect: debe evaluarse una sola vez.
# print() imprime cada vez que se llama, asi que si el select
# evaluara la expresion mas de una vez (por ejemplo, una vez por
# cada caseItem al compararla) veriamos "evaluando" mas de una vez.
func obtenerValor()
    print("evaluando")
    return 42
end

select obtenerValor()
    case 1, 2, 3 then
        print("no")
    case 42 then
        print("cuarenta y dos")
    else
        print("otro")
end

# select anidado
x = 2
y = 1
select x
    case 1, 2 then
        select y
            case 1 then
                print("x en {1,2} e y=1")
            else
                print("x en {1,2} pero y!=1")
        end
    else
        print("otro x")
end
