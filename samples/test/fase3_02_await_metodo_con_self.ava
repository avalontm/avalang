class Contador
    static total = 0

    async func incrementar(self)
        await delay(100)
        self.total = self.total + 1
        return self.total
    end
end

async func main()
    c = Contador()
    a = await c.incrementar()
    b = await c.incrementar()
    print("a=" + str(a) + " b=" + str(b))
end

main()
