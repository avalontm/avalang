import system

Console.WriteLine("plain line")
Console.Write("no newline, then: ")
Console.WriteLine("this")
Console.WriteError("this goes to stderr")

Console.ForegroundColor(Console.Colors.Red)
Console.WriteLine("this should be red")
Console.ResetColor()

Console.ForegroundColor("not-a-real-color")

Console.WriteLine("cwd: " + Environment.GetCurrentDirectory())
Environment.SetEnvironmentVariable("AVALANG_DEMO", "hello")
Console.WriteLine("AVALANG_DEMO=" + Environment.GetEnvironmentVariable("AVALANG_DEMO"))
Console.WriteLine("missing var is nil: " + str(Environment.GetEnvironmentVariable("AVALANG_NOT_SET_XYZ") == nil))

for arg in Environment.GetCommandLineArgs() then
    Console.WriteLine("arg: " + arg)
end

IO.File.WriteAllText("avalang_io_demo.txt", "hello from avalang")
Console.WriteLine("read back: " + IO.File.ReadAllText("avalang_io_demo.txt"))
Console.WriteLine("file exists: " + str(IO.File.Exists("avalang_io_demo.txt")))
Console.WriteLine("file size: " + str(IO.File.Size("avalang_io_demo.txt")))
Console.WriteLine("missing file is nil: " + str(IO.File.ReadAllText("avalang_io_demo_missing.txt") == nil))

IO.Directory.Create("avalang_io_demo_dir")
Console.WriteLine("dir exists: " + str(IO.Directory.Exists("avalang_io_demo_dir")))
Console.WriteLine("file is not a dir: " + str(IO.Directory.Exists("avalang_io_demo.txt") == false))
Console.WriteLine("dir is not a file: " + str(IO.File.Exists("avalang_io_demo_dir") == false))

for entry in IO.Directory.Enumerate(Environment.GetCurrentDirectory()) then
    Console.WriteLine("entry: " + entry.Name + " (dir: " + str(entry.IsDirectory) + ")")
end

IO.Directory.Delete("avalang_io_demo_dir")
IO.File.Delete("avalang_io_demo.txt")
Console.WriteLine("cleanup done, file gone: " + str(IO.File.Exists("avalang_io_demo.txt") == false))

Console.WriteLine("current pid: " + str(Diagnostics.Process.GetCurrentId()))

result = Diagnostics.Process.Start("echo", ["hello", "from", "avalang"])
Console.WriteLine("launch failed is nil: " + str(result == nil))
if result != nil then
    Console.WriteLine("exit code: " + str(result.ExitCode))
end

bogus = Diagnostics.Process.Start("this-binary-should-not-exist-xyz", [])
Console.WriteLine("bogus command is nil: " + str(bogus == nil))

now = DateTime.Now()
Console.WriteLine("now: " + DateTime.ToString(now))
Console.WriteLine("now.Year: " + str(now.Year))
Console.WriteLine("now.DayOfWeek: " + str(now.DayOfWeek))

utc = DateTime.UtcNow()
Console.WriteLine("utc: " + DateTime.ToString(utc))
Console.WriteLine("now == utc (no timezone source yet, documented gap): " + str(now.Ticks == utc.Ticks))

before = DateTime.Now()
DateTime.Sleep(50)
after = DateTime.Now()
Console.WriteLine("slept at least 50ms: " + str(after.Ticks - before.Ticks >= 50))
