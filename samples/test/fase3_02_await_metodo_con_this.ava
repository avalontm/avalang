class Contador 
    static total = 0

    async func incrementar()
        await delay(100)
        this.total = this.total + 1
        return this.total
    end
end

async func main()
    c = Contador()
    a = await c.incrementar()
    b = await c.incrementar()
    print("a=" + str(a) + " b=" + str(b))
end

main()

