+// optional leading kind tag: '\x01' + one kind char, stripped before display and used
+// to pick an icon (custom AvaLang addition, see patches/imguicolortextedit_suggestion_icons.patch)
+static ImU32 suggestionIconColor(char kind) {
+	switch (kind) {
+		case 'M': return IM_COL32(220, 160, 100, 255);	// method
+		case 'F': return IM_COL32(110, 170, 220, 255);	// field / property
+		case 'C': return IM_COL32(180, 130, 220, 255);	// class / interface
+		case 'K': return IM_COL32(190, 100, 120, 255);	// keyword
+		default:  return IM_COL32(150, 150, 150, 255);	// variable / unknown
+	}
+}
+
+static std::string_view splitSuggestionKind(const std::string_view& suggestion, char* outKind) {
+	if (suggestion.size() >= 2 && suggestion[0] == '\x01') {
+		*outKind = suggestion[1];
+		return suggestion.substr(2);
+	}
+
+	*outKind = 0;
+	return suggestion;
+}
+
+static bool renderSuggestion(const std::string_view& rawSuggestion, const std::string_view& searchTerm, float width, bool selected) {
 	// custom widget to render an autocomplete suggestion in the style of Visual Studio Code
+	char kind = 0;
+	auto suggestion = splitSuggestionKind(rawSuggestion, &kind);
+
 	auto glyphPos = ImGui::GetCursorScreenPos();
 	auto size = ImVec2(width, ImGui::GetFrameHeightWithSpacing());
 	auto clicked = ImGui::InvisibleButton("suggestion", size);
