@@ -366,6 +366,24 @@
 	static const Palette& GetDarkPalette();
 	static const Palette& GetLightPalette();
 
+	// AvaLang addition: optional second font used to render specific token
+	// colors in bold (e.g. keywords) while the rest of the text stays on
+	// the regular font. Upstream only ever pulls a single ImFont::GetFont()
+	// per Render() call (see renderText()), with no per-glyph font
+	// selection -- boldFont/boldColors add that without touching the
+	// tokenizer/colorizer. If boldFont is null (default) or a glyph's
+	// color isn't in the bold set, rendering is byte-identical to
+	// upstream. See patches/README.md in the AvaLang repo.
+	// NOTE: this must come after Color/Palette are declared above (moved
+	// here from just after Render() because upstream now declares Color
+	// later in the class than when this patch was first written; see
+	// patches/README.md).
+	inline void SetBoldFont(ImFont* aFont) { boldFont = aFont; }
+	inline void SetBoldColors(std::initializer_list<Color> colors) {
+		boldColors.fill(false);
+		for (Color c : colors) { boldColors[static_cast<size_t>(c)] = true; }
+	}
+
 	// a single colored character (a glyph)
 	class Glyph {
