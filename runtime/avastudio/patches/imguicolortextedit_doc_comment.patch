@@ -3661,6 +3665,34 @@ TextEditor::State TextEditor::Colorizer::update(Line& line, const Language* lang
 			if (CodePoint::isWhiteSpace(glyph->codepoint)) {
 				(glyph++)->color = Color::whitespace;
 
+			// AvaLang addition: "doc comment" blocks (e.g. "##") get their own
+			// color, distinct from plain "#" comments, and the literal
+			// "@param" tag inside them is re-colored again so it stands out
+			// from the surrounding prose -- just the tag itself, not the
+			// parameter name or description that follows (that stays
+			// docComment-colored, same as the rest of the block). Must be
+			// checked before the plain singleLineComment branch below,
+			// since "##" also matches the shorter "#" prefix. See
+			// patches/README.
+			} else if (language->docCommentPrefix.size() && matches(glyph, line.end(), language->docCommentPrefix)) {
+				setColor(glyph, line.end(), Color::docComment);
+
+				auto scan = glyph;
+				static const std::string_view paramTag = "@param";
+
+				while (scan < line.end()) {
+					if (matches(scan, line.end(), paramTag)) {
+						auto tagEnd = scan + paramTag.size();
+						setColor(scan, tagEnd, Color::docParamTag);
+						scan = tagEnd;
+
+					} else {
+						++scan;
+					}
+				}
+
+				glyph = line.end();
+
 			// handle single line comments
 			} else if (language->singleLineComment.size() && matches(glyph, line.end(), language->singleLineComment)) {
 				setColor(glyph, line.end(), Color::comment);
@@ -4904,7 +4944,7 @@ void TextEditor::Autocomplete::updateState(Document& document, const Language* l
 		auto color = document.getColor(Coordinate(currentLocation.line, currentLocation.column - 1));
 		state.inIdentifier = color == Color::identifier || color == Color::knownIdentifier;
 		state.inNumber = color == Color::number;
-		state.inComment = color == Color::comment;
+		state.inComment = color == Color::comment || color == Color::docComment || color == Color::docParamTag;
 		state.inString = color == Color::string;
 	}
 
