 		IM_COL32( 35, 135,   5, 255),	// comment
+		IM_COL32( 26, 130, 120, 255),	// docComment ("##" block, custom AvaLang addition) -- turquoise, distinct from plain "#" comment green and from every other token color
+		IM_COL32(124,  58, 237, 255),	// docParamTag ("@param name" tag, custom AvaLang addition) -- purple, stands out from both comment colors above
