view
    column
        padding = 20
        gap = 12

        button AnimatedButton
            text = "Fade Me"

            animate
                property = "opacity"
                from = "1.0"
                to = "0.2"
                duration = "0.4"
                easing = "ease-in-out"
                trigger = "click"
                mode = "once"
            end
        end
    end
end
