extends layouts.main

properties
    title = "My App"
end

state
    counter = 0
end

view
    column
        fill = "true"
        padding = 20
        gap = 16

        text
            value = "Count: " + counter
            fontSize = 32
        end

        row
            gap = 12

            button Decrease
                text = "-"
            end

            button Increase
                text = "+"
            end

            button Clear
                text = "Clear"
            end
        end
    end
end

code
    func OnDecreaseClick()
        counter--
    end

    func OnIncreaseClick()
        counter++
    end

    func OnClearClick()
        counter = 0
    end
end
